---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Best Digital Marketing Company in Delhi NCR | NK Digital Tech',
  description = 'NK Digital Tech is the best digital marketing company in Delhi NCR. We offer SEO, AI SEO, AEO, GEO, local SEO and web development for real business enquiries.',
  canonical = 'https://www.nkdigitaltech.net/',
} = Astro.props;

const schemaLocalBusiness = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "NK Digital Tech",
  "description": "Best digital marketing company in Delhi NCR delivering SEO, AI SEO, AEO, GEO, local SEO and web development for enterprises across Delhi, Noida, Gurgaon and Lucknow.",
  "url": "https://www.nkdigitaltech.net",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Delhi",
    "addressRegion": "Delhi NCR",
    "addressCountry": "IN"
  },
  "areaServed": ["Delhi","Noida","Gurgaon","Lucknow","Faridabad","Ghaziabad"],
  "serviceType": [
    "Search Engine Optimisation",
    "AI SEO & AI Search Visibility",
    "Answer Engine Optimisation",
    "Generative Engine Optimisation",
    "Local SEO",
    "Website Design and Development",
    "Digital Marketing Services"
  ]
});

const schemaFAQ = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What makes NK Digital Tech the best digital marketing company in Delhi NCR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "NK Digital Tech is recognized as the best digital marketing company in Delhi NCR because we combine foundational organic SEO with modern AI search optimization across Google AI Overviews, ChatGPT and Gemini."
      }
    },
    {
      "@type": "Question",
      "name": "How do your digital marketing services in Delhi NCR differ from traditional agencies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our digital marketing services in Delhi NCR provide complete channel coverage for how modern buyers search, including conversational AI systems, local map packs, featured answer snippets and responsive web assets."
      }
    },
    {
      "@type": "Question",
      "name": "What specific platforms are covered under your AI search visibility services?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our AI search visibility services optimize for Google AI Overviews, ChatGPT, Gemini, Perplexity and Microsoft Copilot."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to achieve measurable results with organic SEO in Delhi NCR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Initial improvements frequently manifest within four to eight weeks. Competitive keyword rankings typically require three to six months of continuous optimisation."
      }
    }
  ]
});
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='48' fill='%230f172a'/><text x='50' y='65' font-size='42' font-family='sans-serif' font-weight='900' fill='%2338bdf8' text-anchor='middle'>NK</text></svg>" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Schema JSON-LD -->
  <script type="application/ld+json" set:html={schemaLocalBusiness} />
  <script type="application/ld+json" set:html={schemaFAQ} />
</head>
<body class="relative min-h-screen flex flex-col selection:bg-brand-500 selection:text-white">

  <!-- Background layers -->
  <div class="fixed inset-0 pointer-events-none grid-pattern z-0"></div>
  <div class="fixed inset-0 pointer-events-none mesh-gradient z-0"></div>

  <!-- Floating glow orbs -->
  <div class="fixed -top-40 -left-40 w-96 h-96 bg-brand-500/20 rounded-full blur-[120px] pointer-events-none animate-blob"></div>
  <div class="fixed top-1/3 -right-40 w-96 h-96 bg-accent-500/20 rounded-full blur-[140px] pointer-events-none animate-blob" style="animation-delay:2s;"></div>
  <div class="fixed -bottom-40 left-1/3 w-96 h-96 bg-cyan-400/15 rounded-full blur-[120px] pointer-events-none animate-blob" style="animation-delay:4s;"></div>

  <!-- NAV -->
  <header class="relative z-20 w-full border-b border-slate-800/60 bg-[#060913]/80 backdrop-blur-md sticky top-0">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-6">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group flex-shrink-0">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 via-brand-500 to-accent-500 flex items-center justify-center font-display font-black text-lg text-white shadow-lg shadow-brand-500/25 group-hover:scale-105 transition-transform duration-300">
          NK
        </div>
        <div>
          <span class="font-display font-extrabold text-lg tracking-tight text-white block leading-none">NK DIGITAL TECH</span>
          <span class="text-[9px] uppercase tracking-widest text-brand-400 font-semibold">Digital Marketing Agency</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-7 text-sm text-slate-300 font-medium">
        <a href="#services" class="hover:text-brand-400 transition-colors">Services</a>
        <a href="#industries" class="hover:text-brand-400 transition-colors">Industries</a>
        <a href="#why-us" class="hover:text-brand-400 transition-colors">Why Us</a>
        <a href="#testimonials" class="hover:text-brand-400 transition-colors">Clients</a>
        <a href="#faq" class="hover:text-brand-400 transition-colors">FAQ</a>
      </nav>

      <!-- CTA -->
      <a href="#contact" class="hidden md:inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-brand-500 to-accent-600 hover:from-brand-400 hover:to-accent-500 text-white font-semibold text-sm shadow-lg shadow-brand-500/25 transition-all duration-300 flex-shrink-0">
        Book Consultation
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/></svg>
      </a>

      <!-- Mobile hamburger -->
      <button id="menu-toggle" class="md:hidden text-slate-300 hover:text-white transition-colors" aria-label="Open menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-slate-800/60 bg-[#060913]/95 px-6 py-4 flex flex-col gap-4 text-sm text-slate-300">
      <a href="#services" class="hover:text-brand-400 transition-colors">Services</a>
      <a href="#industries" class="hover:text-brand-400 transition-colors">Industries</a>
      <a href="#why-us" class="hover:text-brand-400 transition-colors">Why Us</a>
      <a href="#testimonials" class="hover:text-brand-400 transition-colors">Clients</a>
      <a href="#faq" class="hover:text-brand-400 transition-colors">FAQ</a>
      <a href="#contact" class="btn-primary w-fit mt-2">Book Consultation</a>
    </div>
  </header>

  <main class="relative z-10 flex-grow">
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="relative z-10 border-t border-slate-800/80 bg-[#04070f]/70 backdrop-blur-md mt-0">
    <div class="max-w-7xl mx-auto px-6 py-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        <!-- Brand -->
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-600 via-brand-500 to-accent-500 flex items-center justify-center font-display font-black text-base text-white">NK</div>
            <span class="font-display font-extrabold text-base text-white">NK DIGITAL TECH</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">Best digital marketing company in Delhi NCR. SEO, AI SEO, AEO, GEO, Local SEO and Web Development for enterprises across Delhi, Noida, Gurgaon and Lucknow.</p>
        </div>
        <!-- Services -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-brand-400 mb-4">Services</h4>
          <ul class="space-y-2 text-xs text-slate-400">
            <li><a href="#services" class="hover:text-brand-400 transition-colors">Search Engine Optimisation</a></li>
            <li><a href="#services" class="hover:text-brand-400 transition-colors">AI SEO &amp; AI Search Visibility</a></li>
            <li><a href="#services" class="hover:text-brand-400 transition-colors">Answer Engine Optimisation</a></li>
            <li><a href="#services" class="hover:text-brand-400 transition-colors">Generative Engine Optimisation</a></li>
            <li><a href="#services" class="hover:text-brand-400 transition-colors">Local SEO</a></li>
            <li><a href="#services" class="hover:text-brand-400 transition-colors">Website Design &amp; Development</a></li>
          </ul>
        </div>
        <!-- Contact -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-brand-400 mb-4">Contact</h4>
          <ul class="space-y-2 text-xs text-slate-400">
            <li>
              <a href="mailto:connect@nkdigitaltech.com" class="hover:text-brand-400 transition-colors flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                connect@nkdigitaltech.com
              </a>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>Delhi NCR | Noida | Gurgaon | Lucknow</span>
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-slate-800/60 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
        <span>&copy; <span id="footer-year"></span> NK Digital Tech. All rights reserved.</span>
        <span class="text-slate-600">Best Digital Marketing Company in Delhi NCR</span>
      </div>
    </div>
  </footer>

  <script>
    document.getElementById('footer-year')!.textContent = String(new Date().getFullYear());
    const toggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    toggle?.addEventListener('click', () => mobileMenu?.classList.toggle('hidden'));
    // Close mobile menu on link click
    mobileMenu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mobileMenu.classList.add('hidden')));
  </script>
</body>
</html>
