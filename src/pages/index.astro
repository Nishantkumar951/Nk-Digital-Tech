  <section id="testimonials" class="relative surface-dark py-24 px-6 border-b border-slate-800/80 overflow-hidden">
    <div class="absolute inset-0 grid-pattern-dark pointer-events-none"></div>
    <div class="absolute inset-0 mesh-glow pointer-events-none opacity-60"></div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="badge-dark mb-3">Verified Client Outcomes</div>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-white tracking-tight mb-4">
          What Regional Business Leaders Say About NK Digital Tech
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Direct feedback and measurable commercial outcomes from corporate founders, managing directors and marketing heads across Delhi, Noida, Gurgaon and Lucknow who chose NK Digital Tech as their strategic search growth partner.
        </p>
      </div>

      <!-- 2 Columns x 2 Rows Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-7">
        {testimonials.map((t) => (
          <div class="glass-card rounded-2xl p-8 flex flex-col justify-between hover:-translate-y-1">
            <div>
              <!-- Top Rating & Impact Header -->
              <div class="flex items-center justify-between gap-4 mb-5">
                <div class="flex items-center gap-1">
                  {[1, 2, 3, 4, 5].map(() => (
                    <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  ))}
                </div>
                <span class="text-[11px] font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-md">
                  Verified Enterprise Client
                </span>
              </div>

              <!-- Executive Quote -->
              <p class="text-slate-200 text-sm sm:text-base leading-relaxed italic mb-6">
                "{t.quote}"
              </p>

              <!-- Measured Commercial Impact Box -->
              <div class="rounded-xl bg-slate-900/90 border border-slate-700/80 p-4 mb-6">
                <p class="text-[11px] font-bold uppercase tracking-wider text-brand-400 mb-2.5">
                  Measured Commercial Impact
                </p>
                <ul class="space-y-2">
                  {t.metrics.map((m) => (
                    <li class="flex items-start gap-2 text-xs text-slate-300 font-medium">
                      <svg class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span>{m}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Client Profile & Organisation -->
            <div class="flex items-center gap-4 pt-4 border-t border-slate-800">
              <div class="w-14 h-14 rounded-xl bg-white p-2 flex items-center justify-center flex-shrink-0 shadow-sm">
                <img
                  src={t.logo}
                  alt={`${t.company} Logo`}
                  width="48"
                  height="48"
                  class="max-h-10 w-auto object-contain"
                  loading="lazy"
                />
              </div>
              <div>
                <h3 class="font-display font-bold text-white text-base">{t.name}</h3>
                <p class="text-xs text-slate-300">
                  {t.title}, <strong class="text-brand-400 font-semibold">{t.company}</strong>
                </p>
                <p class="text-[11px] text-slate-400 mt-0.5">{t.sector}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 10: HOW WE WORK (CRISP WHITE CONTRAST SECTION - 4 STAGES)
  ===================================================================== -->
  <section class="relative surface-white py-24 px-6 border-b border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="badge-light mb-3">Our Execution Methodology</div>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-slate-900 tracking-tight mb-4">
          Systematic Four-Stage Execution Framework
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          From exhaustive technical diagnostics across Delhi, Noida, Gurgaon and Lucknow to continuous AI citation scaling, our four-stage methodology delivers compounding search authority.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-7">
        {stages.map((s) => (
          <div class="elevated-card rounded-2xl p-8 relative overflow-hidden group hover:-translate-y-1">
            <div class="flex items-center justify-between gap-4 mb-5">
              <span class={`inline-flex items-center px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r ${s.accent}`}>
                {s.num}
              </span>
              <span class="font-display font-black text-4xl text-slate-200 group-hover:text-slate-300 transition-colors">
                {s.step}
              </span>
            </div>
            <h3 class="font-display font-bold text-xl text-slate-900 mb-3 leading-snug">
              {s.title}
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              {s.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 11: FAQ (LIGHT COOL SLATE CONTRAST SECTION)
  ===================================================================== -->
  <section id="faq" class="relative surface-cool py-24 px-6 border-b border-slate-200">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <div class="badge-light mb-3">AEO &amp; AI Citation Ready</div>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-slate-900 tracking-tight mb-4">
          Frequently Asked Questions
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Direct, structured answers covering our SEO, AI search visibility, AEO, GEO and regional operations across Delhi, Noida, Gurgaon and Lucknow.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((f, i) => (
          <details class="elevated-card rounded-2xl group overflow-hidden" open={i === 0}>
            <summary class="flex items-center justify-between gap-4 px-6 py-5 select-none">
              <div class="flex items-center gap-3.5 text-left">
                <span class="w-7 h-7 rounded-lg bg-sky-50 border border-sky-200 text-brand-600 font-display font-bold text-xs flex items-center justify-center flex-shrink-0">
                  0{i + 1}
                </span>
                <span class="font-display font-bold text-slate-900 text-base sm:text-lg leading-snug">
                  {f.q}
                </span>
              </div>
              <span class="faq-icon w-8 h-8 rounded-full border border-slate-200 text-slate-600 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 pt-2 text-slate-600 text-sm sm:text-base leading-relaxed border-t border-slate-100">
              {f.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 12: CONCLUSION & PRIMARY CTA (DARK FRAME + GRADIENT BANNER)
  ===================================================================== -->
  <section id="contact" class="relative surface-dark py-24 px-6 overflow-hidden">
    <div class="absolute inset-0 grid-pattern-dark pointer-events-none"></div>
    <div class="relative z-10 max-w-6xl mx-auto">
      <div class="rounded-3xl bg-gradient-to-br from-brand-600 via-brand-700 to-accent-700 p-8 sm:p-12 md:p-16 text-center text-white shadow-2xl border border-white/15 relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-80 h-80 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-sky-300/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-3xl mx-auto">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/15 border border-white/25 text-white text-xs font-bold uppercase tracking-widest mb-6">
            Schedule Your Comprehensive Digital Audit
          </span>

          <h2 class="font-display font-black text-3xl sm:text-4xl md:text-5xl text-white tracking-tight leading-tight mb-6">
            Partner with the Best Digital Marketing Company in Delhi NCR
          </h2>

          <div class="space-y-4 text-sky-50 text-base sm:text-lg leading-relaxed mb-10">
            <p>
              Achieving sustained commercial growth in the highly competitive Delhi NCR marketplace requires a digital marketing strategy that addresses how real customers find answers today. Brands that limit their efforts to outdated methods fall behind as consumer search habits rapidly transition toward AI-assisted discovery.
            </p>
            <p>
              NK Digital Tech provides the strategic vision, technical capability and operational discipline needed to build lasting digital authority. Whether you require higher Google rankings, commanding local presence across Delhi, Noida, Gurgaon and Lucknow, or verified presence on Google AI Overviews, ChatGPT and Gemini, our team is ready to deliver. Contact our specialists today to schedule your comprehensive digital audit.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="mailto:connect@nkdigitaltech.com"
              class="inline-flex items-center justify-center gap-3 px-9 py-4 rounded-xl bg-white text-slate-950 hover:bg-sky-50 font-display font-bold text-base shadow-xl transition-all duration-300 active:scale-95 w-full sm:w-auto"
            >
              <span>Connect with NK Digital Tech Today</span>
              <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/>
              </svg>
            </a>
          </div>

          <!-- Regional Service Hubs Strip -->
          <div class="mt-10 pt-8 border-t border-white/15 flex flex-wrap items-center justify-center gap-3">
            {['Delhi', 'Noida', 'Gurgaon', 'Lucknow'].map((city) => (
              <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-slate-950/35 border border-white/20 text-xs font-semibold text-white">
                <svg class="w-3.5 h-3.5 text-sky-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                </svg>
                {city}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
