        <a href="/" class="hover:text-brand-400 transition-colors">Home</a>
        <span class="text-slate-600">/</span>
        <a href="/website-development-company-in-delhi/" class="hover:text-brand-400 transition-colors">Delhi</a>
        <span class="text-slate-600">/</span>
        <span class="text-brand-400 font-semibold">Website Development Company in East Delhi</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left Hero Content -->
        <div class="lg:col-span-7 text-left min-w-0">
          <div class="badge-dark mb-4 sm:mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse flex-shrink-0"></span>
