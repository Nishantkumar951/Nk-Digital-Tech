                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-justify">{row.nk}</span>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile Comparison Cards -->
      <div class="md:hidden space-y-3.5">
        {comparison.map((row) => (
          <div class="elevated-card rounded-2xl p-4 space-y-2.5">
            <h3 class="font-display font-bold text-slate-900 text-[15px] leading-snug">{row.metric}</h3>
            <div class="rounded-xl bg-rose-50 border border-rose-100 p-3">
              <div class="flex items-center gap-1.5 mb-1">
                <svg class="w-3.5 h-3.5 text-rose-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
                <p class="text-[10px] font-bold uppercase tracking-wider text-rose-600">Typical Agency Approach</p>
              </div>
              <p class="text-xs text-slate-700 leading-relaxed text-justify hyphens-auto [text-align-last:left]">{row.typical}</p>
            </div>
            <div class="rounded-xl bg-sky-50 border border-sky-200 p-3">
              <div class="flex items-center gap-1.5 mb-1">
                <svg class="w-3.5 h-3.5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <p class="text-[10px] font-bold uppercase tracking-wider text-brand-600">NK Digital Tech Real Estate Engine</p>
              </div>
              <p class="text-xs text-slate-900 font-semibold leading-relaxed text-justify hyphens-auto [text-align-last:left]">{row.nk}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
