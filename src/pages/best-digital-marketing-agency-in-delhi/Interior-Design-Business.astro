---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage="https://www.nkdigitaltech.net/images/delhi-interior-dm/hero-interior-dm-delhi.webp"
  preloadImage="/images/delhi-interior-dm/hero-interior-dm-delhi.webp"
  hideLocationsNav={false}
  customSchemaLocalBusiness={interiorDMServiceSchema}
  customSchemaFAQ={interiorDMFAQSchema}
  customSchemaBreadcrumb={interiorDMBreadcrumbSchema}
  utilityTagline="Digital Marketing for Interior Designers in Delhi • Turnkey Homes, Villas & Office Fit Outs"
  brandSubtitle="Delhi • Interior Studio Digital Marketing"
  footerBio="NK Digital Tech delivers Digital Marketing for Interior Designers in Delhi, helping residential studios, architects, modular showrooms and turnkey office contractors win exclusive clients."
  footerCoreDisciplines={[
    { label: 'Best Digital Marketing Agency in Delhi', href: '/best-digital-marketing-agency-in-delhi/' },
    { label: 'Best SEO Company in Delhi', href: '/best-seo-company-in-delhi/' },
    { label: 'Local SEO Services in Delhi', href: '/local-seo-services-in-delhi/' },
    { label: 'AI SEO Company in Delhi', href: '/ai-seo-company-in-delhi/' },
    { label: 'AEO Services in Delhi', href: '/aeo-services-in-delhi/' },
    { label: 'Website Development Company in Delhi', href: '/website-development-company-in-delhi/' },
  ]}
  footerTagline="Built for High Conversion Interior Studio Growth in Delhi"
>

  <!-- =====================================================================
       SECTION 1: HERO (DARK SURFACE WITH UNIQUE INTERIOR DM HERO IMAGE)
  ===================================================================== -->
  <section class="relative surface-dark overflow-hidden pt-5 pb-9 sm:pt-16 sm:pb-20 lg:pt-20 lg:pb-24 border-b border-slate-800/80">
    <div class="absolute inset-0 grid-pattern-dark pointer-events-none"></div>
    <div class="absolute inset-0 mesh-glow pointer-events-none"></div>
    <div class="absolute -top-24 -left-24 sm:-top-36 sm:-left-36 w-56 h-56 sm:w-96 sm:h-96 bg-brand-500/20 rounded-full blur-[80px] sm:blur-[130px] pointer-events-none"></div>
    <div class="absolute top-1/4 -right-24 sm:-right-36 w-56 h-56 sm:w-96 sm:h-96 bg-accent-500/20 rounded-full blur-[80px] sm:blur-[130px] pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-10 lg:gap-12 items-center">
        <!-- Left 7 Columns: Headline & CTA -->
        <div class="lg:col-span-7 text-left min-w-0">
          <div class="badge-dark mb-3 sm:mb-6 py-1.5 px-2.5 sm:px-3.5">
            <span class="w-2 h-2 rounded-full bg-brand-400 animate-ping flex-shrink-0"></span>
            <span class="min-w-0 break-words">Interior Studio SEO • AEO & GEO • Visual Portfolios</span>
          </div>

          <h1 class="font-display text-[clamp(1.62rem,6.5vw,2.35rem)] sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.15] sm:leading-[1.1] mb-3.5 sm:mb-6 text-glow break-words">
            Digital Marketing for Interior <br />
            <span class="gradient-text-light">Designers in Delhi</span>
          </h1>

          <p class="text-sm sm:text-lg text-slate-300 leading-[1.68] sm:leading-relaxed mb-5 sm:mb-8 font-normal text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
            <Fragment set:html={heroBodyHtml} />
          </p>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 sm:gap-4 mb-5 sm:mb-10">
            <a href="#contact" class="btn-primary w-full sm:w-auto min-h-[50px] text-[13.5px] sm:text-base px-4 sm:px-8 py-3.5 sm:py-4">
              <span>Claim Free Studio Growth Audit</span>
              <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/>
              </svg>
            </a>
            <a href="#services" class="btn-secondary-dark w-full sm:w-auto min-h-[48px] text-[13.5px] sm:text-base px-4 sm:px-7 py-3.5 sm:py-4">
              <span>Explore Our Six Studio Pillars</span>
            </a>
          </div>

          <!-- Trust Verification Strip (2x4 Grid on Mobile, Flex Pills on Desktop) -->
          <div class="pt-5 sm:pt-6 border-t border-slate-800/80">
            <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-stretch sm:items-center gap-2">
              {trustStrip.map((item) => (
                <span class="px-2.5 sm:px-3 py-2 sm:py-1.5 min-h-[42px] sm:min-h-0 rounded-lg bg-slate-900/90 border border-slate-800 text-[11px] sm:text-xs text-slate-300 font-medium flex items-center justify-center sm:justify-start text-center sm:text-left leading-tight break-words">
                  {item}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Right 5 Columns: Unique Delhi interior DM Hero Image -->
        <div class="lg:col-span-5 min-w-0">
          <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden border border-slate-700/80 shadow-2xl shadow-brand-500/15 bg-slate-900 group">
            <div class="relative">
              <img
                src="/images/delhi-interior-dm/hero-interior-dm-delhi.webp"
                alt="Digital Marketing for Interior Designers in Delhi Strategy Team Reviewing Portfolio Growth"
                width="960"
                height="540"
                sizes="(max-width: 1024px) 100vw, 42vw"
                fetchpriority="high"
                decoding="async"
                class="w-full aspect-[16/9] sm:aspect-auto sm:h-72 md:h-[380px] lg:h-[400px] object-cover object-center sm:group-hover:scale-105 transition-transform duration-500"
              />
              <div class="hidden sm:block absolute inset-0 bg-gradient-to-t from-[#050a14] via-transparent to-transparent opacity-80"></div>
            </div>
            <div class="relative sm:absolute sm:bottom-4 sm:left-4 sm:right-4 glass-card border-t sm:border border-slate-800 sm:rounded-2xl p-3.5 sm:p-4">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
                <span class="text-xs font-bold text-white">Turnkey Interior Lead Engine</span>
                <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-400">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 flex-shrink-0"></span>
                  Verified Client Briefs
                </span>
              </div>
              <p class="text-[11px] sm:text-xs text-slate-300 text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left] leading-snug">
                Built to turn local searches, portfolio clicks and AI studio recommendations into paid site consultations across New Delhi.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 2: INTRODUCTION (CRISP WHITE CONTRAST SECTION + TEAM IMAGE)
  ===================================================================== -->
  <section class="relative surface-white py-10 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-200 overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-7 sm:gap-10 lg:gap-12 items-center">
        <!-- Left 7 Columns: Concise 2-Paragraph Unique DM Copy -->
        <div class="lg:col-span-7 min-w-0">
          <div class="badge-light mb-3.5 sm:mb-4">Direct Design Consultation Pipeline</div>
          <h2 class="font-display font-extrabold text-[clamp(1.34rem,5.3vw,1.75rem)] sm:text-3xl lg:text-4xl text-slate-900 tracking-tight leading-[1.22] sm:leading-tight mb-4 sm:mb-6 break-words">
            How Digital Marketing for Interior Designers in Delhi <span class="gradient-text-dark">Wins High Budget Turnkey Clients</span>
          </h2>
          <div class="space-y-4 sm:space-y-5 text-slate-700 text-[13.5px] sm:text-base leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
            <p><Fragment set:html={introP1Html} /></p>
            <p><Fragment set:html={introP2Html} /></p>
          </div>
          <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
            <a href="#contact" class="btn-primary w-full sm:w-auto min-h-[48px]">
              <span>Speak With an Interior Growth Strategist</span>
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/>
              </svg>
            </a>
            <a href="#why-us" class="btn-secondary-light w-full sm:w-auto min-h-[48px]">
              <span>Compare Directories vs Owned Growth</span>
            </a>
          </div>
        </div>

        <!-- Right 5 Columns: Unique Team Image + Stats -->
        <div class="lg:col-span-5 space-y-4 sm:space-y-5 min-w-0">
          <div class="rounded-2xl sm:rounded-3xl overflow-hidden border border-slate-200 shadow-lg bg-slate-100">
            <img
              src="/images/delhi-interior-dm/team-interior-dm-delhi.webp"
              alt="Interior Design Digital Marketing Agency Specialists Reviewing Delhi Project Pipelines"
              width="800"
              height="533"
              sizes="(max-width: 1024px) 100vw, 42vw"
              class="w-full aspect-[16/10] sm:aspect-auto sm:h-64 lg:h-72 object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="grid grid-cols-2 gap-2.5 sm:gap-4">
            {stats.map((stat) => (
              <div class="elevated-card rounded-xl sm:rounded-2xl p-3 sm:p-4 min-w-0 flex flex-col justify-between">
                <div class="font-display font-black text-[1.1rem] sm:text-2xl text-brand-600 mb-0.5 leading-tight break-words">{stat.val}</div>
                <div class="text-[11px] sm:text-xs font-bold text-slate-900 leading-snug">{stat.label}</div>
                <div class="text-[10.5px] sm:text-[11px] text-slate-500 leading-snug mt-0.5">{stat.sub}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 3: PROBLEM STATEMENT (DEEP INDIGO DARK CONTRAST SECTION)
  ===================================================================== -->
  <section class="relative surface-indigo py-10 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-800/80 overflow-hidden">
    <div class="absolute inset-0 grid-pattern-dark pointer-events-none"></div>
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-7 sm:gap-10 lg:gap-12 items-center">
        <!-- Left 7 Columns: Problem Statement Copy -->
        <div class="lg:col-span-7 min-w-0">
          <div class="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-3.5 py-1 sm:py-1.5 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider sm:tracking-widest bg-amber-500/10 border border-amber-500/30 text-amber-300 max-w-full leading-snug mb-4 sm:mb-5">
            <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <span>Fixing Studio Lead Leakage</span>
          </div>

          <h2 class="font-display font-extrabold text-[clamp(1.34rem,5.3vw,1.75rem)] sm:text-3xl lg:text-4xl text-white tracking-tight leading-[1.22] sm:leading-tight mb-4 sm:mb-6 break-words">
            Why Delhi Interior Studios Lose High Budget Projects to Listing Portals
          </h2>

          <div class="space-y-4 sm:space-y-5 text-slate-300 text-[13.5px] sm:text-base leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
            <p><Fragment set:html={problemP1Html} /></p>
            <p><Fragment set:html={problemP2Html} /></p>
          </div>
        </div>

        <!-- Right 5 Columns: Diagnostic Comparison Cards -->
        <div class="lg:col-span-5 space-y-3.5 sm:space-y-4 min-w-0">
          <div class="glass-card rounded-xl sm:rounded-2xl p-4 sm:p-6 border-l-4 border-l-rose-500 min-w-0">
            <div class="flex flex-wrap items-center justify-between gap-1.5 mb-2">
              <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-rose-400">Typical Portal / Agency</span>
              <span class="text-[11px] sm:text-xs text-slate-400">Shared Leads & Price Cuts</span>
            </div>
            <h3 class="font-display font-bold text-[15px] sm:text-base text-white mb-2 leading-snug">Slow Portfolios & Directory Dependence</h3>
            <p class="text-xs text-slate-300 leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
              Competes inside crowded directories for low margin leads, suffers slow gallery load times, and lacks Google Map Pack or ChatGPT studio visibility.
            </p>
          </div>

          <div class="glass-card rounded-xl sm:rounded-2xl p-4 sm:p-6 border-l-4 border-l-emerald-400 min-w-0">
            <div class="flex flex-wrap items-center justify-between gap-1.5 mb-2">
              <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-emerald-400">NK Digital Tech System</span>
              <span class="text-[11px] sm:text-xs text-brand-300">Owned Client Pipeline</span>
            </div>
            <h3 class="font-display font-bold text-[15px] sm:text-base text-white mb-2 leading-snug">Fast Portfolios, Map Packs & AI Authority</h3>
            <p class="text-xs text-slate-300 leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
              Combines colony level SEO, WebP lookbooks, clear turnkey budget guides, local map reviews and AI citations so premium clients contact your studio directly.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 4: SERVICES (LIGHT COOL ALABASTER CONTRAST + SERVICES IMAGE)
  ===================================================================== -->
  <section id="services" class="relative surface-cool py-10 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-200 overflow-hidden scroll-mt-16 sm:scroll-mt-20">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-10 items-center mb-8 sm:mb-16">
        <div class="lg:col-span-7 min-w-0">
          <div class="badge-light mb-3">Our Six Pillar Studio Stack</div>
          <h2 class="font-display font-extrabold text-[clamp(1.34rem,5.3vw,1.75rem)] sm:text-3xl lg:text-4xl text-slate-900 tracking-tight leading-[1.22] sm:leading-tight mb-3 sm:mb-4 break-words">
            Complete Digital Marketing for Interior Designers in Delhi
          </h2>
          <p class="text-slate-600 text-[13.5px] sm:text-base leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
            <Fragment set:html={servicesSubtitleHtml} />
          </p>
        </div>
        <div class="lg:col-span-5 min-w-0">
          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-md bg-white">
            <img
              src="/images/delhi-interior-dm/services-interior-dm-delhi.webp"
              alt="Digital Marketing Services and Visual Portfolio Strategy for Delhi Interior Studios"
              width="800"
              height="450"
              sizes="(max-width: 1024px) 100vw, 42vw"
              class="w-full aspect-[16/9] sm:aspect-auto sm:h-56 lg:h-64 object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <!-- 3 Columns x 2 Rows Grid Layout -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-7">
        {services.map((s) => (
          <div class="elevated-card rounded-2xl p-4 sm:p-7 flex flex-col justify-between group sm:hover:-translate-y-1 min-w-0">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 mb-4 sm:mb-6">
                <div class={`w-11 h-11 sm:w-12 sm:h-12 rounded-xl border flex items-center justify-center flex-shrink-0 ${s.iconStyle}`}>
                  <Fragment set:html={s.icon} />
                </div>
                <div class="flex items-center gap-2">
                  <span class={`text-[10.5px] sm:text-[11px] font-semibold px-2.5 py-1 rounded-md ${s.badgeColor}`}>
                    {s.category}
                  </span>
                  <span class="font-display font-black text-base sm:text-lg text-slate-300">{s.num}</span>
                </div>
              </div>

              <h3 class="font-display font-bold text-[17px] sm:text-xl text-slate-900 mb-2.5 sm:mb-3 leading-snug group-hover:text-brand-600 transition-colors">
                {s.title}
              </h3>

              <p class="text-slate-600 text-[13px] sm:text-sm leading-relaxed mb-4 sm:mb-6 text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
                {s.body}
              </p>
            </div>

            <div>
              <div class={`rounded-xl border p-3.5 sm:p-4 mb-3.5 sm:mb-5 ${s.impactStyle}`}>
                <div class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-slate-900 mb-1">
                  <svg class="w-3.5 h-3.5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>Commercial Impact</span>
                </div>
                <p class="text-xs text-slate-700 leading-relaxed font-medium text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
                  {s.impact}
                </p>
              </div>

              <a href={s.href} class="w-full sm:w-auto inline-flex items-center justify-between sm:justify-start gap-2 rounded-xl sm:rounded-none bg-slate-50 active:bg-sky-50 sm:bg-transparent border border-slate-200/80 sm:border-0 px-3.5 sm:px-0 py-2.5 min-h-[46px] sm:min-h-0 text-xs font-bold text-brand-600 hover:text-brand-700 no-underline hover:no-underline group-hover:gap-3 transition-all">
                <span>{s.cta}</span>
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/>
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 5: REGIONAL LOCATIONS (DARK NAVY + DELHI HUBS)
  ===================================================================== -->
  <section id="locations" class="relative surface-navy py-10 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-800/80 overflow-hidden scroll-mt-16 sm:scroll-mt-20">
    <div class="absolute inset-0 grid-pattern-dark pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-10 items-center mb-8 sm:mb-16">
        <div class="lg:col-span-7 min-w-0">
          <div class="badge-dark mb-3">Area &amp; Hub Level Targeting</div>
          <h2 class="font-display font-extrabold text-[clamp(1.34rem,5.3vw,1.75rem)] sm:text-3xl lg:text-4xl text-white tracking-tight leading-[1.22] sm:leading-tight mb-3 sm:mb-4 break-words">
            Hyper Local Studio Visibility Across Delhi Design & Residential Hubs
          </h2>
          <p class="text-slate-300 text-[13.5px] sm:text-base leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
            <Fragment set:html={locationsSubtitleHtml} />
          </p>
        </div>
        <div class="lg:col-span-5 min-w-0">
          <div class="rounded-2xl overflow-hidden border border-slate-700/80 shadow-xl bg-slate-900">
            <img
              src="/images/delhi-interior-dm/locations-interior-dm-delhi.webp"
              alt="Delhi Interior Design Showrooms and Luxury Home Corridors Across Kirti Nagar and South Delhi"
              width="800"
              height="450"
              sizes="(max-width: 1024px) 100vw, 42vw"
              class="w-full aspect-[16/9] sm:aspect-auto sm:h-56 lg:h-64 object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <!-- 1 Row x 4 Columns Responsive Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        {cities.map((c) => (
          <div class="glass-card rounded-2xl p-4 sm:p-6 flex flex-col justify-between group sm:hover:-translate-y-1 min-w-0">
            <div>
              <div class={`h-1 w-full bg-gradient-to-r ${c.accent} rounded-full mb-4 sm:mb-5`}></div>

              <div class="flex flex-wrap items-center justify-between gap-2 mb-3.5 sm:mb-4">
                <span class="px-2.5 py-1 rounded-md bg-slate-800 border border-slate-700 text-[11px] font-bold uppercase tracking-wider text-brand-300">
                  {c.hub}
                </span>
                <span class="text-xs font-semibold text-slate-400">{c.city}</span>
              </div>

              <h3 class="font-display font-bold text-base sm:text-lg text-white mb-2.5 sm:mb-3 leading-snug">
                <a href={c.href} class="hover:text-brand-300 no-underline hover:no-underline transition-colors">{c.keyword}</a>
              </h3>

              <p class="text-slate-300 text-[13px] sm:text-sm leading-relaxed mb-4 sm:mb-5 text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
                {c.desc}
              </p>
            </div>

            <div class="pt-3.5 sm:pt-4 border-t border-slate-800">
              <p class="text-[11px] text-slate-400 mb-3 sm:mb-4 leading-normal">
                <strong class="text-slate-300">Key Zones:</strong> {c.corridor}
              </p>
              <a href={c.href} class="w-full sm:w-auto inline-flex items-center justify-between sm:justify-start gap-1.5 rounded-xl sm:rounded-none bg-slate-800/90 active:bg-slate-800 sm:bg-transparent border border-slate-700/80 sm:border-0 px-3.5 sm:px-0 py-2.5 min-h-[44px] sm:min-h-0 text-xs font-bold text-brand-400 hover:text-brand-300 no-underline hover:no-underline group-hover:gap-2.5 transition-all">
                <span>{c.cta}</span>
                <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/>
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 6: WHY NK DIGITAL TECH (CRISP WHITE CONTRAST SECTION)
  ===================================================================== -->
  <section id="why-us" class="relative surface-white py-10 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-200 overflow-hidden scroll-mt-16 sm:scroll-mt-20">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto mb-8 sm:mb-14 text-left sm:text-center">
        <div class="badge-light mb-3">Why Delhi Studios Choose NK Digital Tech</div>
