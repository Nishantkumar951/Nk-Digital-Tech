<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage="https://www.nkdigitaltech.net/images/web-dev-east-delhi/website-development-company-east-delhi-hero.webp"
  preloadImage="/images/web-dev-east-delhi/website-development-company-east-delhi-hero.webp"
  useRootNavLinks={true}
  customSchemaLocalBusiness={schemaService}
  customSchemaFAQ={schemaFAQ}
  customSchemaBreadcrumb={schemaBreadcrumb}
  utilityTagline="Custom Web Development • Sub-Second Speed • SEO & AI Ready • East Delhi"
  footerBio="Trusted Website Development Company in East Delhi building fast, mobile first SEO, AEO and GEO optimised websites that turn Google searches and ChatGPT, Gemini and Perplexity citations into daily buyer leads."
  footerCoreDisciplines={webDevEastDelhiFooterDisciplines}
  footerTagline="Website Development Company in East Delhi"
>

  <!-- =====================================================================
