                <span class="text-[11px] font-semibold text-slate-600 bg-slate-100 px-2.5 py-1 rounded-md">
                  {ind.sector}
                </span>
              </div>

              <h3 class="font-display font-bold text-[17px] sm:text-xl text-slate-900 mb-3 sm:mb-4 leading-snug">
                {ind.title}
              </h3>

              <div class="mb-4 sm:mb-5">
                <p class="text-[11px] font-bold uppercase tracking-wider text-brand-600 mb-1.5">
                  Search &amp; AI Strategy
                </p>
                <p class="text-slate-600 text-[13px] sm:text-sm leading-relaxed text-justify hyphens-auto [text-align-last:left]">
                  {ind.focus}
                </p>
              </div>
            </div>

            <div class="rounded-xl bg-emerald-50/70 border border-emerald-200/80 p-3.5 sm:p-4">
              <p class="text-[11px] font-bold uppercase tracking-wider text-emerald-700 mb-1">
                Commercial Result
              </p>
              <p class="text-slate-800 text-xs font-medium leading-relaxed text-justify hyphens-auto [text-align-last:left]">
                {ind.outcome}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 8: HOW WE WORK (CRISP WHITE CONTRAST SECTION - 4 STAGES)
  ===================================================================== -->
  <section class="relative surface-white py-12 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto mb-9 sm:mb-16 text-left sm:text-center">
        <div class="badge-light mb-3">Our 4 Stage Execution</div>
        <h2 class="font-display font-extrabold text-[1.45rem] sm:text-3xl lg:text-4xl text-slate-900 tracking-tight leading-snug sm:leading-tight mb-3 sm:mb-4">
          Our 4-Stage Real Estate SEO Execution Roadmap
        </h2>
        <p class="text-slate-600 text-[13.5px] sm:text-base leading-relaxed text-justify hyphens-auto [text-align-last:left]">
          From initial corridor audit to continuous AI search domination, our systematic roadmap drives compounding pipeline growth for your Gurgaon developments.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-7">
        {stages.map((s) => (
          <div class="elevated-card rounded-2xl p-5 sm:p-8 relative overflow-hidden group sm:hover:-translate-y-1">
            <div class="flex items-center justify-between gap-4 mb-3.5 sm:mb-5">
              <span class={`inline-flex items-center px-2.5 sm:px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r ${s.accent}`}>
                {s.num}
              </span>
              <span class="font-display font-black text-3xl sm:text-4xl text-slate-200 group-hover:text-slate-300 transition-colors">
                {s.step}
              </span>
            </div>
            <h3 class="font-display font-bold text-[17px] sm:text-xl text-slate-900 mb-2.5 sm:mb-3 leading-snug">
              {s.title}
            </h3>
            <p class="text-slate-600 text-[13px] sm:text-sm leading-relaxed text-justify hyphens-auto [text-align-last:left]">
