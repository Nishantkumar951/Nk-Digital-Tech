---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  googleSiteVerification?: string;
  gaMeasurementId?: string;
  customSchemaLocalBusiness?: string;
  customSchemaFAQ?: string;
  customSchemaBreadcrumb?: string;
  utilityTagline?: string;
  brandSubtitle?: string;
  footerBio?: string;
  footerCoreDisciplines?: { label: string; href: string }[];
  footerTagline?: string;
  ogImage?: string;
  preloadImage?: string;
  hideLocationsNav?: boolean;
  hideClientsNav?: boolean;
  hideTestimonialsNav?: boolean;
  useRootNavLinks?: boolean;
}

const {
  title = 'Best Digital Marketing Company in Delhi NCR | NK Digital Tech',
  description = 'Best Digital Marketing Company in Delhi NCR offering SEO, Google Maps ranking, AI search optimization, content marketing & custom website development services.',
  canonical = 'https://www.nkdigitaltech.net/',
  googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || 'XCe2XoxSIG0SKpAcnjbAcI7ESuy2KfkstbyrPh9IsA8',
  gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-8007L4K5V9',
  customSchemaLocalBusiness,
  customSchemaFAQ,
  customSchemaBreadcrumb,
  utilityTagline = 'SEO • AI Search Visibility • AEO • GEO • Local SEO',
  brandSubtitle = 'Search & AI Growth Partners',
  footerBio = 'Best digital marketing company in Delhi NCR delivering Search Engine Optimisation, AI Search Visibility, AEO, GEO, Local SEO and high-performance web development across Delhi, Noida, Gurgaon and Lucknow.',
  footerCoreDisciplines = [
    { label: 'Search Engine Optimisation (SEO)', href: '/best-seo-company-in-delhi-ncr/' },
    { label: 'AI SEO & AI Search Visibility', href: '/ai-seo-company-in-delhi-ncr/' },
    { label: 'Local SEO & Google Business Profile', href: '/local-seo-services-in-delhi-ncr/' },
    { label: 'Answer Engine Optimisation (AEO)', href: '/aeo-services-in-delhi-ncr/' },
    { label: 'Generative Engine Optimisation (GEO)', href: '/geo-services-in-delhi-ncr/' },
    { label: 'Website Design and Development', href: '/best-website-development-company-in-delhi-ncr/' },
    { label: 'Digital Marketing Services', href: '/#services' },
  ],
  footerTagline = 'Best Digital Marketing Company in Delhi NCR',
  ogImage = 'https://www.nkdigitaltech.net/images/hero-best-digital-marketing-company-delhi-ncr.webp',
  preloadImage,
  hideLocationsNav = false,
  hideClientsNav = false,
  hideTestimonialsNav = false,
  useRootNavLinks = false,
} = Astro.props;

const navPrefix = useRootNavLinks ? '/' : '';
const is404Page = canonical === 'https://www.nkdigitaltech.net/404';
const faqHref = is404Page ? '/#faq' : '#faq';
const contactCtaHref = is404Page ? '/contact-us/' : '#contact';

const schemaLocalBusiness = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "NK Digital Tech",
  "description": "Best digital marketing company in Delhi NCR delivering SEO, AI SEO, AEO, GEO, local SEO and web development for enterprises across Delhi, Noida, Gurgaon and Lucknow.",
  "url": "https://www.nkdigitaltech.net",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Delhi",
    "addressRegion": "Delhi NCR",
    "addressCountry": "IN"
  },
  "areaServed": ["Delhi", "Noida", "Gurgaon", "Lucknow", "Faridabad", "Ghaziabad"],
  "serviceType": [
    "Search Engine Optimisation",
    "AI SEO & AI Search Visibility",
    "Answer Engine Optimisation",
    "Generative Engine Optimisation",
    "Local SEO",
    "Website Design and Development",
    "Digital Marketing Services"
  ]
});

const schemaFAQ = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What makes NK Digital Tech the best digital marketing company in Delhi NCR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "NK Digital Tech is recognised as the best digital marketing company in Delhi NCR because we combine foundational organic SEO with modern AI search optimisation across Google AI Overviews, ChatGPT and Gemini. Rather than relying on outdated techniques or third-party outsourcing, our in-house strategists build tailored campaigns that prioritise genuine commercial enquiries over cosmetic traffic numbers."
      }
    },
    {
      "@type": "Question",
      "name": "How do your digital marketing services in Delhi NCR differ from traditional agencies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our digital marketing services in Delhi NCR provide complete channel coverage for how modern buyers search. While conventional agencies focus exclusively on standard Google rankings, we optimise your business entity across conversational AI systems, local map packs, featured answer snippets and responsive web assets, backed by full client account ownership and revenue-focused reporting."
      }
    },
    {
      "@type": "Question",
      "name": "What specific platforms are covered under your AI search visibility services?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our AI search visibility services optimise your digital assets for discovery across Google AI Overviews, ChatGPT, Gemini, Perplexity and Microsoft Copilot. We ensure your corporate entity, product capabilities and service credentials are structured and verified so that conversational AI assistants accurately cite and recommend your business."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to achieve measurable results with organic SEO in Delhi NCR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Initial improvements in local search visibility, technical performance and Google Business Profile discovery frequently manifest within four to eight weeks. Competitive commercial keyword rankings and broader domain authority typically require three to six months of structured, continuous optimisation, depending on existing domain strength and regional industry competition."
      }
    },
    {
      "@type": "Question",
      "name": "Why should a business invest in AEO and GEO alongside standard SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Answer Engine Optimisation (AEO) and Generative Engine Optimisation (GEO) capture the rapidly growing volume of users who rely on instant answer snippets and generative AI recommendations. Implementing these strategies alongside standard SEO ensures your business remains visible across both traditional search listings and modern AI search answers."
      }
    },
    {
      "@type": "Question",
      "name": "Does NK Digital Tech handle digital marketing for small and mid-sized enterprises?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We partner with emerging enterprises, regional establishments and expanding mid-market companies across Delhi, Noida, Gurgaon, Lucknow, Faridabad and Ghaziabad. We construct custom, phased roadmaps that concentrate resources on the specific channels that generate the highest commercial return for your operating budget."
      }
    },
    {
      "@type": "Question",
      "name": "What geographical areas within Delhi NCR do your teams cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We serve commercial enterprises situated throughout the National Capital Region and key regional hubs, including South, Central, West, North and East Delhi, Noida, Greater Noida, Gurugram, Lucknow, Faridabad and Ghaziabad. Depending on client objectives, we also execute regional and pan-India organic growth campaigns."
      }
    },
    {
      "@type": "Question",
      "name": "How does NK Digital Tech measure and report campaign success?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We measure success through verified business metrics: qualified form inquiries, inbound phone calls, organic keyword progression for commercial phrases, local pack visibility and confirmed AI citations. Clients receive transparent, scheduled reporting with direct access to campaign strategists."
      }
    }
  ]
});

// Automated BreadcrumbList Schema for Google SERP Trails
let schemaBreadcrumb = '';
if (customSchemaBreadcrumb) {
  schemaBreadcrumb = customSchemaBreadcrumb;
} else if (canonical && canonical !== 'https://www.nkdigitaltech.net/' && canonical !== 'https://www.nkdigitaltech.net') {
  const pageName = title ? title.split('|')[0].trim() : 'Service';
  const urlPath = canonical.replace('https://www.nkdigitaltech.net', '').replace(/^\/|\/$/g, '');

  const items: { '@type': string; position: number; name: string; item: string }[] = [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.nkdigitaltech.net/"
    }
  ];

  const southKeys = ['hauz-khas', 'saket', 'greater-kailash', 'vasant-vihar', 'defence-colony', 'lajpat-nagar', 'malviya-nagar', 'green-park', 'okhla', 'nehru-place', 'chhatarpur', 'jasola'];
  const northKeys = ['rohini', 'pitampura', 'model-town', 'shalimar-bagh', 'ashok-vihar', 'civil-lines', 'mukherjee-nagar', 'azadpur', 'wazirpur', 'narela', 'bawana', 'netaji-subhash-place'];
  const westKeys = ['janakpuri', 'rajouri-garden', 'punjabi-bagh', 'tilak-nagar', 'paschim-vihar', 'patel-nagar', 'vikaspuri', 'kirti-nagar', 'uttam-nagar', 'naraina', 'dwarka', 'mayapuri'];
  const eastKeys = ['laxmi-nagar', 'mayur-vihar', 'preet-vihar', 'patparganj', 'vivek-vihar', 'shahdara', 'krishna-nagar', 'gandhi-nagar', 'shakarpur', 'ip-extension', 'karkardooma', 'nirman-vihar'];

  const isDM = urlPath.includes('digital-marketing');
  const isWebDev = urlPath.includes('website-development') || urlPath.includes('website-designing');

  if (southKeys.some(k => urlPath.includes(k))) {
    items.push({
      "@type": "ListItem",
      "position": 2,
      "name": isWebDev ? "South Delhi Website Development" : (isDM ? "South Delhi Digital Marketing" : "South Delhi SEO"),
      "item": isWebDev ? "https://www.nkdigitaltech.net/website-development-company-in-south-delhi/" : (isDM ? "https://www.nkdigitaltech.net/digital-marketing-company-in-south-delhi/" : "https://www.nkdigitaltech.net/best-seo-company-in-south-delhi/")
    });
    items.push({
      "@type": "ListItem",
      "position": 3,
      "name": pageName,
      "item": canonical
    });
  } else if (northKeys.some(k => urlPath.includes(k))) {
    items.push({
      "@type": "ListItem",
      "position": 2,
      "name": isWebDev ? "North Delhi Website Development" : (isDM ? "North Delhi Digital Marketing" : "North Delhi SEO"),
      "item": isWebDev ? "https://www.nkdigitaltech.net/website-development-company-in-north-delhi/" : (isDM ? "https://www.nkdigitaltech.net/digital-marketing-company-in-north-delhi/" : "https://www.nkdigitaltech.net/best-seo-company-in-north-delhi/")
    });
    items.push({
      "@type": "ListItem",
      "position": 3,
      "name": pageName,
      "item": canonical
    });
  } else if (westKeys.some(k => urlPath.includes(k))) {
    items.push({
      "@type": "ListItem",
      "position": 2,
      "name": isWebDev ? "West Delhi Website Development" : (isDM ? "West Delhi Digital Marketing" : "West Delhi SEO"),
      "item": isWebDev ? "https://www.nkdigitaltech.net/website-development-company-in-west-delhi/" : (isDM ? "https://www.nkdigitaltech.net/digital-marketing-company-in-west-delhi/" : "https://www.nkdigitaltech.net/best-seo-company-in-west-delhi/")
    });
    items.push({
      "@type": "ListItem",
      "position": 3,
      "name": pageName,
      "item": canonical
    });
  } else if (eastKeys.some(k => urlPath.includes(k))) {
    items.push({
      "@type": "ListItem",
      "position": 2,
      "name": isWebDev ? "East Delhi Website Development" : (isDM ? "East Delhi Digital Marketing" : "East Delhi SEO"),
      "item": isWebDev ? "https://www.nkdigitaltech.net/website-development-company-in-east-delhi/" : (isDM ? "https://www.nkdigitaltech.net/digital-marketing-company-in-east-delhi/" : "https://www.nkdigitaltech.net/best-seo-company-in-east-delhi/")
    });
    items.push({
      "@type": "ListItem",
      "position": 3,
      "name": pageName,
      "item": canonical
    });
  } else if (urlPath.includes('south-delhi') || urlPath.includes('north-delhi') || urlPath.includes('west-delhi') || urlPath.includes('east-delhi')) {
    items.push({
      "@type": "ListItem",
      "position": 2,
      "name": isWebDev ? "Delhi Website Development" : (isDM ? "Delhi Digital Marketing" : "Delhi SEO"),
      "item": isWebDev ? "https://www.nkdigitaltech.net/website-development-company-in-delhi/" : (isDM ? "https://www.nkdigitaltech.net/best-digital-marketing-agency-in-delhi/" : "https://www.nkdigitaltech.net/best-seo-company-in-delhi/")
    });
    items.push({
      "@type": "ListItem",
      "position": 3,
      "name": pageName,
      "item": canonical
    });
  } else {
    items.push({
      "@type": "ListItem",
      "position": 2,
      "name": pageName,
      "item": canonical
    });
  }

  schemaBreadcrumb = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": items
  });
}
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="NK Digital Tech" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {preloadImage && (
    <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
  )}

  <!-- PWA & Theme -->
  <meta name="theme-color" content="#0284c7" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="sitemap" href="/sitemap.xml" />

  <!-- Google Search Console Verification -->
  {googleSiteVerification && (
    <meta name="google-site-verification" content={googleSiteVerification} />
  )}

  <!-- Google Analytics 4 (GA4) -->
  {gaMeasurementId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
      <script is:inline set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', '${gaMeasurementId}');
      `} />
    </>
  )}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Fonts Non-Blocking Preload -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
  </noscript>

  <!-- Schema JSON-LD -->
  <script type="application/ld+json" set:html={customSchemaLocalBusiness || schemaLocalBusiness} />
  <script type="application/ld+json" set:html={customSchemaFAQ || schemaFAQ} />
  {schemaBreadcrumb && (
    <script type="application/ld+json" set:html={schemaBreadcrumb} />
  )}
</head>
