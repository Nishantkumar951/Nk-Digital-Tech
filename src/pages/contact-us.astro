---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const pageTitle = 'Contact Us for SEO & Digital Marketing | NK Digital Tech';
const pageDescription = 'Contact NK Digital Tech for SEO, AI SEO, AEO, GEO and web development. Call 8052189051 or visit our Lucknow office at Khazana Complex, Aashiana Colony.';
const pageCanonical = 'https://www.nkdigitaltech.net/contact-us/';

const faqs = [
  {
    q: 'How quickly will I receive a response after submitting the contact form?',
    a: 'Every enquiry submitted through our website is delivered directly to our senior strategy desk at nkdigitaltech1@gmail.com. You will receive a personal response via phone, WhatsApp or email within 4 business hours (Monday to Saturday, 10:00 AM to 7:00 PM IST).'
  },
  {
    q: 'Where is the NK Digital Tech Lucknow office located?',
    a: 'Our Lucknow office is located at Khazana Complex, Aashiana Colony, Lucknow, Uttar Pradesh. Clients across Lucknow and nearby commercial corridors are welcome to schedule an in-person consultation by calling 8052189051 prior to visiting.'
  },
  {
    q: 'Do you work with businesses outside Lucknow, such as Delhi NCR, Noida and Gurgaon?',
    a: 'Yes. Alongside our Lucknow office at Khazana Complex, Aashiana Colony, we actively manage organic SEO, AI Search Visibility (AEO & GEO), Google Business Profile and web development campaigns for enterprises across South, North, East and West Delhi, Noida, Gurgaon, Faridabad and Ghaziabad.'
  },
  {
    q: 'What is included in your initial SEO and AI Search consultation?',
    a: 'Before our call, our specialists review your existing website architecture, current Google rankings, local map pack standing and visibility across ChatGPT, Gemini and Google AI Overviews. During the consultation, we share practical findings and outline a clear 90 day growth plan.'
  },
  {
    q: 'Can I contact your team directly via phone or WhatsApp?',
    a: 'Yes. You can call us directly on +91 80521 89051 (8052189051) or start a direct WhatsApp conversation on the same number for quick questions, audit requests or meeting scheduling.'
  },
  {
    q: 'Is there any obligation or fee for the initial website review?',
    a: 'No. Our initial discovery call and preliminary search audit carry zero cost or obligation. You receive straightforward technical and commercial recommendations tailored to your target market and budget.'
  }
];

const customSchemaLocalBusiness = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "NK Digital Tech",
  "url": "https://www.nkdigitaltech.net/contact-us/",
  "image": "https://www.nkdigitaltech.net/images/hero-best-digital-marketing-company-delhi-ncr.webp",
  "description": "Contact NK Digital Tech for SEO, AI Search Visibility, AEO, GEO, Local SEO and high speed website development across Lucknow, Delhi, Noida and Gurgaon.",
  "telephone": "+91-8052189051",
  "email": "nkdigitaltech1@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Khazana Complex, Aashiana Colony",
    "addressLocality": "Lucknow",
    "addressRegion": "Uttar Pradesh",
    "addressCountry": "IN"
  },
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+91-8052189051",
      "email": "nkdigitaltech1@gmail.com",
      "contactType": "sales",
      "areaServed": ["IN"],
      "availableLanguage": ["English", "Hindi"]
    }
  ],
  "areaServed": ["Lucknow", "Delhi", "Noida", "Gurgaon", "Faridabad", "Ghaziabad"],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "10:00",
      "closes": "19:00"
    }
  ]
});

const customSchemaFAQ = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
});

const regionalDirectories = [
  {
    title: 'Lucknow Hub',
    subtitle: 'Aashiana Colony, Gomti Nagar, Hazratganj, Aliganj & Indira Nagar',
    href: '/best-seo-company-in-lucknow/',
    badge: 'UP Office Hub'
  },
  {
    title: 'Delhi NCR Hub',
    subtitle: 'Complete Search, AI SEO, AEO, GEO & Web Architecture across NCR',
    href: '/best-seo-company-in-delhi-ncr/',
    badge: 'Primary NCR Hub'
  },
  {
    title: 'South Delhi',
    subtitle: 'Nehru Place, Okhla, Saket, GK, Hauz Khas, Vasant Vihar & Green Park',
    href: '/best-seo-company-in-south-delhi/',
    badge: '12 Corridors'
  },
  {
    title: 'North Delhi',
    subtitle: 'NSP, Pitampura, Rohini, Model Town, Mukherjee Nagar & Wazirpur',
    href: '/best-seo-company-in-north-delhi/',
    badge: '12 Corridors'
  },
  {
    title: 'West Delhi',
    subtitle: 'Rajouri Garden, Janakpuri, Dwarka, Kirti Nagar, Punjabi Bagh & Mayapuri',
    href: '/best-seo-company-in-west-delhi/',
    badge: '12 Corridors'
  },
  {
    title: 'East Delhi',
    subtitle: 'Laxmi Nagar, Preet Vihar, Mayur Vihar, Patparganj & Karkardooma',
    href: '/best-seo-company-in-east-delhi/',
    badge: '12 Corridors'
  },
  {
    title: 'Noida & Greater Noida',
    subtitle: 'Sector 62, Sector 18, Noida Expressway & Ecotech Industrial Hubs',
    href: '/best-seo-company-in-noida/',
    badge: 'IT & Industrial'
  },
  {
    title: 'Gurgaon (Gurugram)',
    subtitle: 'DLF Cyber City, Golf Course Road, Sohna Road, Udyog Vihar & Manesar',
    href: '/best-seo-company-in-gurgaon/',
    badge: 'Enterprise Hub'
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  customSchemaLocalBusiness={customSchemaLocalBusiness}
  customSchemaFAQ={customSchemaFAQ}
  useRootNavLinks={true}
>

  <!-- =====================================================================
       SECTION 1: HERO SECTION WITH CONTACT FORM ON THE RIGHT (DARK SURFACE)
  ===================================================================== -->
  <section id="contact" class="relative surface-dark pt-8 pb-14 sm:pt-14 sm:pb-20 lg:pt-16 lg:pb-24 px-4 sm:px-6 overflow-hidden border-b border-slate-800/80">
    <div class="absolute inset-0 grid-pattern-dark pointer-events-none"></div>
    <div class="absolute inset-0 mesh-glow pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <!-- Breadcrumb Trail -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-400 mb-5 sm:mb-6">
        <a href="/" class="hover:text-brand-400 transition-colors">Home</a>
        <span class="text-slate-600">/</span>
        <span class="text-brand-400 font-semibold">Contact Us</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-start">

        <!-- Left Column (7 cols): Hero Headline & Quick Direct Contact Channels -->
        <div class="lg:col-span-7 text-left min-w-0">
          <div class="badge-dark mb-3.5 sm:mb-5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Direct Senior Strategist Access • Response Within 4 Business Hours
          </div>

          <h1 class="font-display font-black text-2xl sm:text-4xl lg:text-5xl text-white tracking-tight leading-[1.14] sm:leading-[1.12] mb-4 sm:mb-6">
            Contact <span class="gradient-text-light">NK Digital Tech</span> for Measurable Search &amp; AI Growth
          </h1>

          <p class="text-slate-300 text-sm sm:text-base lg:text-lg leading-relaxed mb-6 sm:mb-8 text-left sm:text-justify sm:hyphens-auto">
            Speak directly with our search engineers and digital growth specialists. Whether you want higher Google rankings, Map Pack enquiries, AI citations across ChatGPT and Gemini, or a high-speed conversion-ready website, fill out the enquiry form or reach our Lucknow desk directly.
          </p>

          <!-- 3 Quick Contact Cards in Hero -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4 mb-6 sm:mb-8">
            <!-- Card 1: Call or WhatsApp -->
            <div class="glass-card rounded-2xl p-4 sm:p-5 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-3 mb-2.5">
                  <div class="w-9 h-9 rounded-xl bg-brand-500/15 border border-brand-400/30 text-brand-400 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                  </div>
                  <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-brand-400 block leading-tight">Call / WhatsApp</span>
                    <a href="tel:+918052189051" class="font-display font-bold text-base sm:text-lg text-white hover:text-brand-300 transition-colors block leading-tight">
                      +91 80521 89051
                    </a>
                  </div>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed mb-3">
                  Direct mobile line (<strong class="text-slate-200">8052189051</strong>). Mon to Sat, 10 AM to 7 PM IST.
                </p>
              </div>
              <div class="flex items-center gap-2 pt-2.5 border-t border-slate-800/80">
                <a
                  href="tel:+918052189051"
                  class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold transition-colors flex-1 text-center"
                >
                  <span>Call Now</span>
                </a>
                <a
                  href="https://wa.me/918052189051?text=Hi%20NK%20Digital%20Tech%2C%20I%20would%20like%20to%20discuss%20SEO%20and%20digital%20marketing%20for%20my%20business."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/30 text-emerald-300 text-xs font-semibold transition-colors flex-1 text-center"
                >
                  <span>WhatsApp</span>
                </a>
              </div>
            </div>

            <!-- Card 2: Direct Email -->
            <div class="glass-card rounded-2xl p-4 sm:p-5 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-3 mb-2.5">
                  <div class="w-9 h-9 rounded-xl bg-accent-500/15 border border-accent-400/30 text-indigo-300 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-300 block leading-tight">Enquiry Desk Email</span>
                    <a href="mailto:nkdigitaltech1@gmail.com" class="font-display font-bold text-sm sm:text-base text-white hover:text-brand-300 transition-colors block leading-tight truncate">
                      nkdigitaltech1@gmail.com
                    </a>
                  </div>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed mb-3">
                  Share your website URL, target market, or RFP documents directly via email.
                </p>
              </div>
              <div class="pt-2.5 border-t border-slate-800/80">
                <a
                  href="mailto:nkdigitaltech1@gmail.com?subject=Website%20%26%20SEO%20Consultation%20Enquiry"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-400 hover:text-brand-300 transition-colors"
                >
                  <span>Send Direct Email</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Trust Strip -->
          <div class="p-4 rounded-2xl bg-slate-900/90 border border-slate-800/90">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 rounded-full bg-brand-400"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-200">Our Service Commitments</span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 text-xs text-slate-300">
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <span>4-Hr Response</span>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <span>100% Confidential</span>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Direct Strategist Review</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column (5 cols): The Form Placed Right Inside Hero -->
        <div class="lg:col-span-5 min-w-0 w-full">
          <div class="elevated-card rounded-2xl sm:rounded-3xl p-5 sm:p-7 md:p-8 bg-white text-slate-900 shadow-2xl border border-slate-200 relative">
            <div class="badge-light mb-2.5">Request a Consultation or Audit</div>
            <h2 class="font-display font-extrabold text-xl sm:text-2xl text-slate-900 tracking-tight mb-1.5">
              Send Us Your Project Details
            </h2>
            <p class="text-slate-600 text-xs sm:text-[13px] leading-relaxed mb-5 sm:mb-6">
              All enquiries are delivered straight to <strong class="text-slate-800">nkdigitaltech1@gmail.com</strong>. All fields marked with <span class="text-rose-600 font-bold">*</span> are required.
            </p>

            <!-- Success Message Panel (Hidden by default) -->
            <div id="form-success" class="hidden rounded-2xl bg-emerald-50 border border-emerald-200 p-5 sm:p-6 mb-5">
              <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div class="min-w-0">
                  <h3 id="form-success-title" class="font-display font-bold text-base sm:text-lg text-emerald-950 mb-1 leading-snug">
                    Thank You! We will contact you soon.
                  </h3>
                  <p id="form-success-desc" class="text-emerald-800 text-xs leading-relaxed mb-3.5">
                    We have received your enquiry for <strong>nkdigitaltech1@gmail.com</strong>. One of our senior strategists will review your requirements and reach out soon.
                  </p>
                  <div class="flex flex-col sm:flex-row flex-wrap gap-2">
                    <a
                      id="success-mailto-btn"
                      href="mailto:nkdigitaltech1@gmail.com"
                      class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold transition-colors text-center"
                    >
                      <span>Send Direct Email Copy</span>
                    </a>
                    <a
                      id="success-whatsapp-btn"
                      href="https://wa.me/918052189051"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold transition-colors text-center"
                    >
                      <span>Send via WhatsApp</span>
                    </a>
                    <button
                      type="button"
                      id="form-reset-btn"
                      class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-lg bg-white hover:bg-emerald-100 border border-emerald-300 text-emerald-900 text-xs font-semibold transition-colors text-center"
                    >
                      <span>Send Another Message</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Error Fallback Panel (Hidden by default) -->
            <div id="form-error" class="hidden rounded-2xl bg-amber-50 border border-amber-200 p-4 sm:p-5 mb-5">
              <h3 class="font-display font-bold text-sm sm:text-base text-amber-950 mb-1">
                Connection Interrupted: Send Directly in One Click
              </h3>
              <p id="form-error-text" class="text-amber-900 text-xs leading-relaxed mb-3">
                Click either button below to send your pre-filled enquiry immediately:
              </p>
              <div class="flex flex-wrap gap-2">
                <a
                  id="fallback-mailto"
                  href="mailto:nkdigitaltech1@gmail.com"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold transition-colors"
                >
                  <span>Email nkdigitaltech1@gmail.com</span>
                </a>
                <a
                  id="fallback-whatsapp"
                  href="https://wa.me/918052189051"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold transition-colors"
                >
                  <span>WhatsApp (8052189051)</span>
                </a>
              </div>
            </div>

            <!-- Form Element -->
            <form
              id="contact-form"
              action="https://formsubmit.co/nkdigitaltech1@gmail.com"
              method="POST"
              class="space-y-3.5 sm:space-y-4"
            >
              <!-- FormSubmit Configuration Fields -->
              <input type="hidden" name="_subject" value="New Website Enquiry: NK Digital Tech" />
              <input type="hidden" name="_template" value="table" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-3.5">
                <!-- Full Name -->
                <div>
                  <label for="full-name" class="block text-xs font-semibold text-slate-800 mb-1">
                    Full Name <span class="text-rose-600">*</span>
                  </label>
                  <input
                    type="text"
                    id="full-name"
                    name="Full_Name"
                    required
                    placeholder="e.g. Rajesh Sharma"
                    class="w-full rounded-xl border border-slate-300 bg-slate-50/70 px-3.5 py-2.5 text-xs sm:text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 transition-all"
                  />
                </div>

                <!-- Mobile Number (10 digits only, without +91) -->
                <div>
                  <label for="mobile-number" class="block text-xs font-semibold text-slate-800 mb-1">
                    Mobile Number (10 Digits) <span class="text-rose-600">*</span>
                  </label>
                  <input
                    type="tel"
                    id="mobile-number"
                    name="Mobile_Number"
                    required
                    inputmode="numeric"
                    maxlength="10"
                    pattern="[0-9]{10}"
                    title="Please enter a 10-digit mobile number without +91 or spaces (e.g. 9876543210)"
                    placeholder="e.g. 9876543210"
                    class="w-full rounded-xl border border-slate-300 bg-slate-50/70 px-3.5 py-2.5 text-xs sm:text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 transition-all"
                  />
                  <p id="mobile-helper" class="text-[10.5px] text-slate-500 mt-0.5">
                    10 digits without +91.
                  </p>
                </div>
              </div>

              <!-- Service Required (Full Width) -->
              <div>
                <label for="service-required" class="block text-xs font-semibold text-slate-800 mb-1">
                  Service Required <span class="text-rose-600">*</span>
                </label>
                <select
                  id="service-required"
                  name="Service_Required"
                  required
                  class="w-full rounded-xl border border-slate-300 bg-slate-50/70 px-3.5 py-2.5 text-xs sm:text-sm text-slate-900 focus:border-brand-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 transition-all"
                >
                  <option value="Search Engine Optimisation (SEO)">Search Engine Optimisation (SEO)</option>
                  <option value="AI SEO, AEO & GEO (ChatGPT / Gemini)">AI SEO, AEO &amp; GEO (ChatGPT / Gemini)</option>
                  <option value="Local SEO & Google Business Profile">Local SEO &amp; Google Business Profile</option>
                  <option value="Website Design & Development">Website Design &amp; Development</option>
                  <option value="Complete Digital Marketing">Complete Digital Marketing</option>
                  <option value="Others">Others</option>
                </select>
              </div>

              <div class="pt-1">
                <button
                  type="submit"
                  id="submit-btn"
                  class="btn-primary w-full py-3.5 text-sm sm:text-base font-bold shadow-lg shadow-brand-500/25"
                >
                  <span id="submit-btn-text">Send Enquiry to NK Digital Tech</span>
                  <svg id="submit-btn-icon" class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/>
                  </svg>
                </button>
                <p class="text-[10.5px] sm:text-[11px] text-slate-500 mt-2.5 text-center">
                  100% confidential. No automated sales spam, direct review by our senior search team.
                </p>
              </div>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 2: LUCKNOW OFFICE, MAP & 3-STAGE CONSULTATION ROADMAP (LIGHT SURFACE)
  ===================================================================== -->
  <section class="relative surface-slate py-12 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <div class="badge-light mb-3">Office Location &amp; Process</div>
        <h2 class="font-display font-extrabold text-2xl sm:text-3xl lg:text-4xl text-slate-900 tracking-tight mb-3">
          Visit Our Lucknow Office or Consult Online
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed text-left sm:text-justify sm:hyphens-auto">
          Clients across Lucknow and nearby corridors are welcome to schedule an in-person session at our Aashiana office, while enterprises across Delhi NCR, Noida, and Gurgaon connect via dedicated video consultations.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        <!-- Column 1 (7 cols): Lucknow Office Card & Map -->
        <div class="lg:col-span-7">
