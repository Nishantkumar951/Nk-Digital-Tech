                NK Digital Tech Legal Authority
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-sm">
            {comparison.map((row, idx) => (
              <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/80'}>
                <td class="py-5 px-6 font-display font-bold text-slate-900">
                  {row.metric}
                </td>
                <td class="py-5 px-6 text-slate-600 border-l border-slate-200">
                  <div class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-rose-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    <span class="text-justify">{row.typical}</span>
                  </div>
                </td>
                <td class="py-5 px-6 text-slate-900 font-medium border-l border-slate-200 bg-sky-50/40">
                  <div class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-emerald-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-justify">{row.nk}</span>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile Comparison Cards -->
      <div class="md:hidden space-y-3.5">
        {comparison.map((row) => (
          <div class="elevated-card rounded-2xl p-4 space-y-3 min-w-0">
            <h3 class="font-display font-bold text-slate-900 text-sm pb-2 border-b border-slate-100 leading-snug">{row.metric}</h3>
            <div class="rounded-xl bg-rose-50 border border-rose-100 p-3">
              <div class="flex items-center gap-1.5 mb-1">
                <svg class="w-3.5 h-3.5 text-rose-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
                <p class="text-[10px] font-bold uppercase tracking-wider text-rose-600">Advocate Directories / Generic Vendor</p>
              </div>
              <p class="text-xs text-slate-700 leading-relaxed">{row.typical}</p>
            </div>
            <div class="rounded-xl bg-sky-50 border border-sky-200 p-3">
              <div class="flex items-center gap-1.5 mb-1">
                <svg class="w-3.5 h-3.5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <p class="text-[10px] font-bold uppercase tracking-wider text-brand-600">NK Digital Tech Legal Authority</p>
              </div>
              <p class="text-xs text-slate-900 font-semibold leading-relaxed">{row.nk}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 7: SECTOR VERTICALS WE SCALE (LIGHT SLATE 3x2 GRID)
  ===================================================================== -->
  <section id="industries" class="relative surface-slate py-10 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-200 overflow-hidden scroll-mt-16 sm:scroll-mt-20">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto mb-8 sm:mb-16 text-left sm:text-center">
        <div class="badge-light mb-3">Legal Practice Areas We Serve</div>
        <h2 class="font-display font-extrabold text-[clamp(1.34rem,5.3vw,1.75rem)] sm:text-3xl lg:text-4xl text-slate-900 tracking-tight leading-[1.22] sm:leading-tight mb-3 sm:mb-4 break-words">
          Factual Digital Architecture for Six Delhi Legal Practice Areas
        </h2>
        <p class="text-slate-600 text-[13.5px] sm:text-base leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
          Whether your chambers focus on corporate transactions, NCLT restructuring, IP enforcement or RERA compliance, we present verifiable legal expertise clearly.
        </p>
      </div>

      <!-- 3 Columns x 2 Rows Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-7">
        {sectorSegments.map((ind) => (
          <div class={`elevated-card rounded-2xl p-4 sm:p-7 border-t-4 ${ind.accentBorder} flex flex-col justify-between sm:hover:-translate-y-1 min-w-0`}>
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 mb-4 sm:mb-5">
                <div class={`w-10 h-10 sm:w-11 sm:h-11 rounded-xl border flex items-center justify-center flex-shrink-0 ${ind.iconBg}`}>
                  <Fragment set:html={ind.icon} />
                </div>
                <span class="text-[11px] font-semibold text-slate-600 bg-slate-100 px-2.5 py-1 rounded-md">
                  {ind.sector}
                </span>
              </div>

              <h3 class="font-display font-bold text-[17px] sm:text-xl text-slate-900 mb-3 sm:mb-4 leading-snug">
                {ind.title}
              </h3>

              <div class="mb-4 sm:mb-5">
                <p class="text-[11px] font-bold uppercase tracking-wider text-brand-600 mb-1.5">
                  Digital Growth Strategy
                </p>
                <p class="text-slate-600 text-[13px] sm:text-sm leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
                  {ind.focus}
                </p>
              </div>
            </div>

            <div class="rounded-xl bg-emerald-50/70 border border-emerald-200/80 p-3.5 sm:p-4">
              <p class="text-[11px] font-bold uppercase tracking-wider text-emerald-700 mb-1">
                Commercial Result
              </p>
              <p class="text-slate-800 text-xs font-medium leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
                {ind.outcome}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 8: HOW WE WORK (CRISP WHITE CONTRAST SECTION - 4 STAGES)
  ===================================================================== -->
  <section class="relative surface-white py-10 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-200 overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto mb-8 sm:mb-16 text-left sm:text-center">
        <div class="badge-light mb-3">Our 4 Stage Execution</div>
        <h2 class="font-display font-extrabold text-[clamp(1.34rem,5.3vw,1.75rem)] sm:text-3xl lg:text-4xl text-slate-900 tracking-tight leading-[1.22] sm:leading-tight mb-3 sm:mb-4 break-words">
          How We Build BCI Mindful Legal Search Authority in Delhi
        </h2>
        <p class="text-slate-600 text-[13.5px] sm:text-base leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
          Our four stage model establishes factual chamber structure first, cleans up Google Map listings and earns authoritative legal citations across Google and AI engines.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-7">
        {stages.map((st) => (
          <div class="elevated-card rounded-2xl p-4 sm:p-8 relative overflow-hidden group sm:hover:-translate-y-1 min-w-0">
            <div class="flex items-center justify-between gap-4 mb-3.5 sm:mb-5">
              <span class={`inline-flex items-center px-2.5 sm:px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r ${st.accent}`}>
                {st.num}
              </span>
              <span class="font-display font-black text-3xl sm:text-4xl text-slate-200 group-hover:text-slate-300 transition-colors">
                {st.step}
              </span>
            </div>
            <h3 class="font-display font-bold text-[17px] sm:text-xl text-slate-900 mb-2.5 sm:mb-3 leading-snug">
              {st.title}
            </h3>
            <p class="text-slate-600 text-[13px] sm:text-sm leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
              {st.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 9: CONCLUSION / PARTNER SECTION (DARK INDIGO + GROWTH IMAGE)
  ===================================================================== -->
  <section class="relative surface-indigo py-10 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-800/80 overflow-hidden">
    <div class="absolute inset-0 grid-pattern-dark pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-7 sm:gap-10 lg:gap-12 items-center">
        <!-- Left 7 Columns: Conclusion Paragraphs -->
        <div class="lg:col-span-7 min-w-0">
          <div class="badge-dark mb-3.5 sm:mb-4">Dignified Digital Authority</div>
          <h2 class="font-display font-extrabold text-[clamp(1.34rem,5.3vw,1.75rem)] sm:text-3xl lg:text-4xl text-white tracking-tight leading-[1.22] sm:leading-tight mb-4 sm:mb-6 break-words">
            Build Lasting Credibility With Digital Marketing for Law Firms in Delhi
          </h2>
          <div class="space-y-4 sm:space-y-5 text-slate-300 text-[13.5px] sm:text-base leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
            <p><Fragment set:html={conclusionP1Html} /></p>
            <p><Fragment set:html={conclusionP2Html} /></p>
          </div>
        </div>

        <!-- Right 5 Columns: Unique Delhi law Growth Image -->
        <div class="lg:col-span-5 min-w-0">
          <div class="rounded-2xl sm:rounded-3xl overflow-hidden border border-slate-700/80 shadow-2xl bg-slate-900">
            <img
              src="/images/delhi-law-dm/growth-law-dm-delhi.webp"
              alt="Delhi Law Firm Partners Reviewing Practice Area Search Presence and Credibility"
              width="800"
              height="450"
              sizes="(max-width: 1024px) 100vw, 42vw"
              class="w-full aspect-[16/10] sm:aspect-auto sm:h-64 lg:h-72 object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 10: FAQ (LIGHT COOL SLATE CONTRAST SECTION)
  ===================================================================== -->
  <section id="faq" class="relative surface-cool py-10 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-200 overflow-hidden scroll-mt-16 sm:scroll-mt-20">
    <div class="max-w-4xl mx-auto">
      <div class="text-left sm:text-center mb-8 sm:mb-14">
        <div class="badge-light mb-3">Questions Asked on Google, ChatGPT &amp; Gemini</div>
        <h2 class="font-display font-extrabold text-[clamp(1.34rem,5.3vw,1.75rem)] sm:text-3xl lg:text-4xl text-slate-900 tracking-tight leading-[1.22] sm:leading-tight mb-3 sm:mb-4 break-words">
          Frequently Asked Questions About Digital Marketing for Law Firms in Delhi
        </h2>
        <p class="text-slate-600 text-[13.5px] sm:text-base leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
          Clear, direct answers to the questions managing partners and advocates ask about building ethical, BCI mindful online visibility.
        </p>
      </div>

      <div class="space-y-3 sm:space-y-4">
        {faqs.map((f, i) => (
          <details class="elevated-card rounded-2xl group overflow-hidden" open={i === 0}>
            <summary class="flex items-start sm:items-center justify-between gap-3 sm:gap-4 px-4 sm:px-6 py-4 sm:py-5 min-h-[54px] select-none">
              <div class="flex items-start sm:items-center gap-2.5 sm:gap-3.5 text-left min-w-0">
                <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-sky-50 border border-sky-200 text-brand-600 font-display font-bold text-xs flex items-center justify-center flex-shrink-0 mt-0.5 sm:mt-0">
                  {i + 1 < 10 ? `0${i + 1}` : i + 1}
                </span>
                <span class="font-display font-bold text-slate-900 text-[14px] sm:text-base md:text-lg leading-snug break-words">
                  {f.q}
                </span>
              </div>
              <span class="faq-icon w-7 h-7 sm:w-8 sm:h-8 rounded-full border border-slate-200 text-slate-600 flex items-center justify-center flex-shrink-0 mt-0.5 sm:mt-0">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
              </span>
            </summary>
            <div class="px-4 sm:px-6 pb-5 sm:pb-6 pt-3 text-slate-600 text-[13px] sm:text-sm md:text-base leading-relaxed border-t border-slate-100 text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
              {f.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 11: SHORT 2 TO 3 LINE CALL TO ACTION BANNER (LAST SECTION)
  ===================================================================== -->
  <section id="contact" class="relative surface-dark py-10 pb-28 sm:py-16 lg:py-20 px-4 sm:px-6 overflow-hidden scroll-mt-16 sm:scroll-mt-20">
    <div class="absolute inset-0 grid-pattern-dark pointer-events-none"></div>
    <div class="relative z-10 max-w-5xl mx-auto">
      <div class="rounded-2xl sm:rounded-3xl bg-gradient-to-r from-brand-600 via-brand-700 to-accent-700 p-6 sm:p-10 md:p-12 text-center text-white shadow-2xl border border-white/15 relative overflow-hidden">
        <div class="relative z-10 max-w-2xl mx-auto">
          <h2 class="font-display font-black text-[clamp(1.38rem,5.4vw,1.85rem)] sm:text-3xl md:text-4xl text-white tracking-tight leading-[1.2] sm:leading-snug mb-3 sm:mb-4 break-words">
            Ready to Strengthen Your Firm Authority & Counsel Discovery in Delhi?
          </h2>

          <p class="text-sky-50 text-[13px] sm:text-sm md:text-base leading-relaxed mb-6 sm:mb-8 text-left sm:text-center">
            Request a confidential audit of your website, LegalService schema and AI search presence across New Delhi.
          </p>

          <a
            href="/contact-us/"
            class="inline-flex w-full sm:w-auto min-h-[50px] items-center justify-center gap-2 sm:gap-3 px-5 sm:px-8 py-3.5 sm:py-4 rounded-xl bg-white text-slate-950 hover:bg-sky-50 no-underline hover:no-underline font-display font-bold text-sm sm:text-base shadow-xl transition-all duration-300 active:scale-95 text-center leading-snug"
          >
            <span>Request Legal Authority Audit</span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-brand-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mobile Sticky Bottom Quick Action Bar -->
  <div class="mobile-sticky-cta sm:hidden fixed bottom-0 inset-x-0 z-40 bg-[#050a14]/95 backdrop-blur-xl border-t border-slate-800 px-3.5 pt-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))] shadow-[0_-8px_24px_rgba(0,0,0,0.45)] transition-all duration-300">
    <div class="flex items-center gap-2.5">
      <a
        href="/contact-us/"
        class="btn-primary flex-1 min-h-[44px] py-2.5 px-4 text-xs font-bold rounded-xl no-underline hover:no-underline"
      >
        <span>Request Legal Audit</span>
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/>
        </svg>
      </a>
      <a
        href="#services"
        class="btn-secondary-dark min-h-[44px] py-2.5 px-3.5 text-xs font-semibold rounded-xl flex-shrink-0 no-underline hover:no-underline"
      >
        <span>Services</span>
      </a>
    </div>
  </div>

</Layout>
