            <div class="rounded-xl bg-rose-50 border border-rose-100 p-3">
              <div class="flex items-center gap-1.5 mb-1">
                <svg class="w-3.5 h-3.5 text-rose-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
                <p class="text-[10px] font-bold uppercase tracking-wider text-rose-600">Directory Portals / Generic Agency</p>
              </div>
              <p class="text-xs text-slate-700 leading-relaxed">{row.typical}</p>
            </div>
            <div class="rounded-xl bg-sky-50 border border-sky-200 p-3">
              <div class="flex items-center gap-1.5 mb-1">
                <svg class="w-3.5 h-3.5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <p class="text-[10px] font-bold uppercase tracking-wider text-brand-600">NK Digital Tech Education Growth</p>
              </div>
