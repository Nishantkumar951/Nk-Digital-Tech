              alt="NK Digital Tech real estate search marketing results showing exponential growth in luxury property inquiries across Gurgaon"
              width="800"
              height="450"
              class="w-full aspect-[16/10] sm:aspect-auto sm:h-64 lg:h-72 object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 10: FAQ (LIGHT COOL SLATE CONTRAST SECTION)
  ===================================================================== -->
  <section id="faq" class="relative surface-cool py-12 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-200">
    <div class="max-w-4xl mx-auto">
