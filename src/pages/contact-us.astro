  <!-- Inline Form Handler -->
  <script is:inline>
    (function () {
      const form = document.getElementById('contact-form');
      const mobileInput = document.getElementById('mobile-number');
      const mobileHelper = document.getElementById('mobile-helper');
      const submitBtn = document.getElementById('submit-btn');
      const submitBtnText = document.getElementById('submit-btn-text');
      const successBox = document.getElementById('form-success');
      const successDesc = document.getElementById('form-success-desc');
      const successMailtoBtn = document.getElementById('success-mailto-btn');
      const successWhatsappBtn = document.getElementById('success-whatsapp-btn');
      const errorBox = document.getElementById('form-error');
      const resetBtn = document.getElementById('form-reset-btn');
      const fallbackMailto = document.getElementById('fallback-mailto');
      const fallbackWhatsapp = document.getElementById('fallback-whatsapp');

      // Popup Elements
      const popup = document.getElementById('thank-you-popup');
      const popupCloseX = document.getElementById('popup-close-x');
      const popupCloseBtn = document.getElementById('popup-close-btn');

      function openPopup() {
        if (!popup) return;
        popup.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function closePopup() {
        if (!popup) return;
        popup.classList.add('hidden');
        document.body.style.overflow = '';
      }

      if (popupCloseX) popupCloseX.addEventListener('click', closePopup);
      if (popupCloseBtn) popupCloseBtn.addEventListener('click', closePopup);

      if (popup) {
        popup.addEventListener('click', function (e) {
          if (e.target === popup) {
            closePopup();
          }
        });
      }

      window.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && popup && !popup.classList.contains('hidden')) {
          closePopup();
        }
      });

      if (!form) return;

      // Sanitize mobile input to digits only (automatically strip +91 or 0 prefix if pasted)
      function sanitizeMobile(raw) {
        let digits = String(raw || '').replace(/\D/g, '');
        if (digits.length === 12 && digits.indexOf('91') === 0) {
          digits = digits.slice(2);
        } else if (digits.length === 11 && digits.indexOf('0') === 0) {
          digits = digits.slice(1);
        }
        return digits.slice(0, 10);
      }

      if (mobileInput) {
        mobileInput.addEventListener('input', function () {
          const cleaned = sanitizeMobile(mobileInput.value);
          if (mobileInput.value !== cleaned) {
            mobileInput.value = cleaned;
          }
          mobileInput.setCustomValidity('');
          if (mobileHelper) {
            mobileHelper.textContent = 'Enter 10-digit mobile number without +91.';
            mobileHelper.className = 'text-[11px] text-slate-500 mt-1';
          }
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          closePopup();
          successBox.classList.add('hidden');
          errorBox.classList.add('hidden');
          form.classList.remove('hidden');
          form.reset();
        });
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        errorBox.classList.add('hidden');

        if (mobileInput) {
          const cleanedMobile = sanitizeMobile(mobileInput.value);
          mobileInput.value = cleanedMobile;
          if (!/^[0-9]{10}$/.test(cleanedMobile)) {
            mobileInput.setCustomValidity('Please enter a valid 10-digit mobile number without +91.');
            if (mobileHelper) {
              mobileHelper.textContent = 'Please enter a valid 10-digit mobile number without +91.';
              mobileHelper.className = 'text-[11px] text-rose-600 font-semibold mt-1';
            }
            mobileInput.reportValidity();
            return;
          }
        }

        const formData = new FormData(form);
        if (formData.get('_honey')) return;

        // Ensure FormData has the clean 10-digit mobile number
        if (mobileInput) {
          formData.set('Mobile_Number', mobileInput.value);
        }

        const payload = {};
        formData.forEach(function (value, key) {
          payload[key] = value;
        });

        const summaryLines = [
          'Name: ' + (payload.Full_Name || ''),
          'Mobile: ' + (payload.Mobile_Number || ''),
          'Service: ' + (payload.Service_Required || '')
        ].join('\n');

        const mailtoUrl =
          'mailto:nkdigitaltech1@gmail.com?subject=' +
          encodeURIComponent('New Website Enquiry: ' + (payload.Full_Name || 'NK Digital Tech') + ' (' + (payload.Mobile_Number || '') + ')') +
          '&body=' +
          encodeURIComponent(summaryLines);

        const whatsappUrl =
          'https://wa.me/918052189051?text=' +
          encodeURIComponent('New Website Enquiry:\n' + summaryLines);

        if (fallbackMailto) fallbackMailto.href = mailtoUrl;
        if (fallbackWhatsapp) fallbackWhatsapp.href = whatsappUrl;
        if (successMailtoBtn) successMailtoBtn.href = mailtoUrl;
        if (successWhatsappBtn) successWhatsappBtn.href = whatsappUrl;

        const originalText = submitBtnText ? submitBtnText.textContent : 'Send Enquiry to NK Digital Tech';
        if (submitBtn) submitBtn.disabled = true;
        if (submitBtnText) submitBtnText.textContent = 'Sending Your Enquiry...';

        try {
          const res = await fetch('https://formsubmit.co/ajax/nkdigitaltech1@gmail.com', {
            method: 'POST',
            headers: {
              'Accept': 'application/json'
            },
            body: formData
          });

          const data = await res.json().catch(function () { return {}; });
          const msg = String(data.message || '').toLowerCase();
          const needsActivation = msg.indexOf('activate') !== -1 || msg.indexOf('activation') !== -1;
          const isSuccess =
            res.ok &&
            (data.success === true ||
              data.success === 'true' ||
              needsActivation);

          if (isSuccess) {
            form.classList.add('hidden');
            successBox.classList.remove('hidden');
            openPopup();
            successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });

            if (needsActivation && successDesc) {
              successDesc.innerHTML =
                'Your enquiry has been recorded for <strong>nkdigitaltech1@gmail.com</strong>. Click the button below to also open your email client or WhatsApp with your pre-filled details for instant delivery.';
            }

            if (typeof window.gtag === 'function') {
              window.gtag('event', 'generate_lead', {
                event_category: 'Contact Form',
                event_label: payload.Service_Required || 'General Enquiry'
              });
            }
          } else {
            errorBox.classList.remove('hidden');
            errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        } catch (err) {
          errorBox.classList.remove('hidden');
          errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (submitBtnText) submitBtnText.textContent = originalText;
        }
      });
    })();
  </script>

