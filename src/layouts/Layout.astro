---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  googleSiteVerification?: string;
  gaMeasurementId?: string;
}

const {
  title = 'Best Digital Marketing Company in Delhi NCR | NK Digital Tech',
  description = 'NK Digital Tech is the best digital marketing company in Delhi NCR. We offer SEO, AI SEO, AEO, GEO, local SEO and web development for real business enquiries.',
  canonical = 'https://www.nkdigitaltech.net/',
  googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || 'XCe2XoxSIG0SKpAcnjbAcI7ESuy2KfkstbyrPh9IsA8',
  gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-8007L4K5V9',
} = Astro.props;

const schemaLocalBusiness = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "NK Digital Tech",
  "description": "Best digital marketing company in Delhi NCR delivering SEO, AI SEO, AEO, GEO, local SEO and web development for enterprises across Delhi, Noida, Gurgaon and Lucknow.",
  "url": "https://www.nkdigitaltech.net",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Delhi",
    "addressRegion": "Delhi NCR",
    "addressCountry": "IN"
  },
  "areaServed": ["Delhi", "Noida", "Gurgaon", "Lucknow", "Faridabad", "Ghaziabad"],
  "serviceType": [
    "Search Engine Optimisation",
    "AI SEO & AI Search Visibility",
    "Answer Engine Optimisation",
    "Generative Engine Optimisation",
    "Local SEO",
    "Website Design and Development",
    "Digital Marketing Services"
  ]
});

const schemaFAQ = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What makes NK Digital Tech the best digital marketing company in Delhi NCR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "NK Digital Tech is recognised as the best digital marketing company in Delhi NCR because we combine foundational organic SEO with modern AI search optimisation across Google AI Overviews, ChatGPT and Gemini. Rather than relying on outdated techniques or third-party outsourcing, our in-house strategists build tailored campaigns that prioritise genuine commercial enquiries over cosmetic traffic numbers."
      }
    },
    {
      "@type": "Question",
      "name": "How do your digital marketing services in Delhi NCR differ from traditional agencies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our digital marketing services in Delhi NCR provide complete channel coverage for how modern buyers search. While conventional agencies focus exclusively on standard Google rankings, we optimise your business entity across conversational AI systems, local map packs, featured answer snippets and responsive web assets, backed by full client account ownership and revenue-focused reporting."
      }
    },
    {
      "@type": "Question",
      "name": "What specific platforms are covered under your AI search visibility services?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our AI search visibility services optimise your digital assets for discovery across Google AI Overviews, ChatGPT, Gemini, Perplexity and Microsoft Copilot. We ensure your corporate entity, product capabilities and service credentials are structured and verified so that conversational AI assistants accurately cite and recommend your business."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to achieve measurable results with organic SEO in Delhi NCR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Initial improvements in local search visibility, technical performance and Google Business Profile discovery frequently manifest within four to eight weeks. Competitive commercial keyword rankings and broader domain authority typically require three to six months of structured, continuous optimisation, depending on existing domain strength and regional industry competition."
      }
    },
    {
      "@type": "Question",
      "name": "Why should a business invest in AEO and GEO alongside standard SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Answer Engine Optimisation (AEO) and Generative Engine Optimisation (GEO) capture the rapidly growing volume of users who rely on instant answer snippets and generative AI recommendations. Implementing these strategies alongside standard SEO ensures your business remains visible across both traditional search listings and modern AI search answers."
      }
    },
    {
      "@type": "Question",
      "name": "Does NK Digital Tech handle digital marketing for small and mid-sized enterprises?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We partner with emerging enterprises, regional establishments and expanding mid-market companies across Delhi, Noida, Gurgaon, Lucknow, Faridabad and Ghaziabad. We construct custom, phased roadmaps that concentrate resources on the specific channels that generate the highest commercial return for your operating budget."
      }
    },
    {
      "@type": "Question",
      "name": "What geographical areas within Delhi NCR do your teams cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We serve commercial enterprises situated throughout the National Capital Region and key regional hubs, including South, Central, West, North and East Delhi, Noida, Greater Noida, Gurugram, Lucknow, Faridabad and Ghaziabad. Depending on client objectives, we also execute regional and pan-India organic growth campaigns."
      }
    },
    {
      "@type": "Question",
      "name": "How does NK Digital Tech measure and report campaign success?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We measure success through verified business metrics: qualified form inquiries, inbound phone calls, organic keyword progression for commercial phrases, local pack visibility and confirmed AI citations. Clients receive transparent, scheduled reporting with direct access to campaign strategists."
      }
    }
  ]
});
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="sitemap" href="/sitemap.xml" />

  <!-- Google Search Console Verification -->
  {googleSiteVerification && (
    <meta name="google-site-verification" content={googleSiteVerification} />
  )}

  <!-- Google Analytics 4 (GA4) -->
  {gaMeasurementId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
      <script is:inline set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', '${gaMeasurementId}');
      `} />
    </>
  )}

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='48' fill='%230f172a'/><text x='50' y='65' font-size='42' font-family='sans-serif' font-weight='900' fill='%2338bdf8' text-anchor='middle'>NK</text></svg>" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Schema JSON-LD -->
  <script type="application/ld+json" set:html={schemaLocalBusiness} />
  <script type="application/ld+json" set:html={schemaFAQ} />
</head>
<body class="relative min-h-screen flex flex-col selection:bg-brand-500 selection:text-white">

  <!-- Top Utility Bar -->
  <div class="bg-[#030710] border-b border-slate-800/80 text-slate-400 text-xs py-2 px-6 hidden sm:block">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-4">
        <span class="inline-flex items-center gap-1.5 text-slate-300 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Serving Enterprises in Delhi, Noida, Gurgaon &amp; Lucknow
        </span>
        <span class="text-slate-700">|</span>
        <span>SEO &bull; AI Search Visibility &bull; AEO &bull; GEO &bull; Local SEO</span>
      </div>
      <a href="mailto:connect@nkdigitaltech.com" class="hover:text-brand-400 transition-colors font-medium">
        connect@nkdigitaltech.com
      </a>
    </div>
  </div>

  <!-- Sticky Navigation Header -->
  <header class="w-full border-b border-slate-800/80 bg-[#050a14]/90 backdrop-blur-xl sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-6">

      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3.5 group flex-shrink-0">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-brand-600 via-brand-500 to-accent-500 flex items-center justify-center font-display font-black text-xl text-white shadow-lg shadow-brand-500/25 group-hover:scale-105 transition-transform duration-300">
          NK
        </div>
        <div>
          <span class="font-display font-extrabold text-lg tracking-tight text-white block leading-none">
            NK DIGITAL TECH
          </span>
          <span class="text-[10px] uppercase tracking-widest text-brand-400 font-semibold block mt-1">
            Search &amp; AI Growth Partners
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-7 text-sm text-slate-300 font-medium">
        <a href="#services" class="hover:text-brand-400 transition-colors">Services</a>
        <a href="#locations" class="hover:text-brand-400 transition-colors">Locations</a>
        <a href="#why-us" class="hover:text-brand-400 transition-colors">Why Us</a>
        <a href="#clients" class="hover:text-brand-400 transition-colors">Clients</a>
        <a href="#industries" class="hover:text-brand-400 transition-colors">Industries</a>
        <a href="#testimonials" class="hover:text-brand-400 transition-colors">Results</a>
        <a href="#faq" class="hover:text-brand-400 transition-colors">FAQ</a>
      </nav>

      <!-- Header CTA -->
      <div class="hidden md:flex items-center gap-3 flex-shrink-0">
        <a href="#contact" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-brand-500 to-accent-600 hover:from-brand-400 hover:to-accent-500 text-white font-semibold text-sm shadow-lg shadow-brand-500/25 transition-all duration-300">
          <span>Book a Consultation</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/>
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="menu-toggle" class="lg:hidden text-slate-300 hover:text-white p-2 rounded-lg border border-slate-800" aria-label="Open navigation menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu Drawer -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-800 bg-[#050a14] px-6 py-5 flex flex-col gap-4 text-sm text-slate-300">
      <a href="#services" class="hover:text-brand-400 transition-colors py-1">Services</a>
      <a href="#locations" class="hover:text-brand-400 transition-colors py-1">Regional Hubs</a>
      <a href="#why-us" class="hover:text-brand-400 transition-colors py-1">Why NK Digital Tech</a>
      <a href="#clients" class="hover:text-brand-400 transition-colors py-1">Our Clients</a>
      <a href="#industries" class="hover:text-brand-400 transition-colors py-1">Industries</a>
      <a href="#testimonials" class="hover:text-brand-400 transition-colors py-1">Client Testimonials</a>
      <a href="#faq" class="hover:text-brand-400 transition-colors py-1">FAQ</a>
      <a href="#contact" class="btn-primary w-full mt-2">Book a Strategic Consultation</a>
    </div>
  </header>

  <main class="flex-grow">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-800/80 bg-[#030710] text-slate-400">
    <div class="max-w-7xl mx-auto px-6 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
        <!-- Column 1: Brand -->
        <div class="lg:col-span-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 via-brand-500 to-accent-500 flex items-center justify-center font-display font-black text-lg text-white">
              NK
            </div>
            <div>
              <span class="font-display font-extrabold text-base text-white block leading-none">NK DIGITAL TECH</span>
              <span class="text-[10px] uppercase tracking-widest text-brand-400 font-semibold">Delhi NCR &amp; Lucknow</span>
            </div>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mb-5">
            Best digital marketing company in Delhi NCR delivering Search Engine Optimisation, AI Search Visibility, AEO, GEO, Local SEO and high-performance web development across Delhi, Noida, Gurgaon and Lucknow.
          </p>
          <div class="flex flex-wrap gap-2">
            {['Delhi', 'Noida', 'Gurgaon', 'Lucknow'].map((city) => (
              <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-slate-900 border border-slate-800 text-slate-300">
                {city}
              </span>
            ))}
          </div>
        </div>

        <!-- Column 2: Core Services -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Core Disciplines</h4>
          <ul class="space-y-2.5 text-xs">
            <li><a href="#services" class="hover:text-brand-400 transition-colors">Search Engine Optimisation (SEO)</a></li>
            <li><a href="#services" class="hover:text-brand-400 transition-colors">AI SEO &amp; AI Search Visibility</a></li>
            <li><a href="#services" class="hover:text-brand-400 transition-colors">Local SEO &amp; Google Business Profile</a></li>
            <li><a href="#services" class="hover:text-brand-400 transition-colors">Answer Engine Optimisation (AEO)</a></li>
            <li><a href="#services" class="hover:text-brand-400 transition-colors">Generative Engine Optimisation (GEO)</a></li>
            <li><a href="#services" class="hover:text-brand-400 transition-colors">Website Design and Development</a></li>
          </ul>
        </div>

        <!-- Column 3: Regional Service Centers -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Regional Service Centers</h4>
          <ul class="space-y-2.5 text-xs">
            <li><a href="#locations" class="hover:text-brand-400 transition-colors">Digital Marketing Services in Delhi</a></li>
            <li><a href="#locations" class="hover:text-brand-400 transition-colors">Digital Marketing Services in Noida</a></li>
            <li><a href="#locations" class="hover:text-brand-400 transition-colors">Digital Marketing Services in Gurgaon</a></li>
            <li><a href="#locations" class="hover:text-brand-400 transition-colors">Digital Marketing Services in Lucknow</a></li>
          </ul>
        </div>

        <!-- Column 4: Direct Contact -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest text-white mb-4">Connect With Us</h4>
          <ul class="space-y-3 text-xs">
            <li>
              <a href="mailto:connect@nkdigitaltech.com" class="hover:text-brand-400 transition-colors flex items-center gap-2.5 text-slate-300 font-medium">
                <svg class="w-4 h-4 text-brand-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                connect@nkdigitaltech.com
              </a>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-brand-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>Serving Delhi, Noida, Gurgaon, Lucknow, Faridabad &amp; Ghaziabad</span>
            </li>
          </ul>
          <div class="mt-6">
            <a href="#contact" class="inline-flex items-center gap-2 text-xs font-semibold text-brand-400 hover:text-brand-300">
              Schedule Your Digital Audit
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="border-t border-slate-800/80 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
        <div>
          &copy; <span id="footer-year"></span> <strong class="text-slate-300 font-semibold">NK Digital Tech</strong>. All rights reserved.
        </div>
        <div class="text-slate-400">
          Best Digital Marketing Company in Delhi NCR
        </div>
      </div>
    </div>
  </footer>

  <script>
    const yearEl = document.getElementById('footer-year');
    if (yearEl) yearEl.textContent = String(new Date().getFullYear());
    const toggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    toggle?.addEventListener('click', () => mobileMenu?.classList.toggle('hidden'));
    mobileMenu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mobileMenu.classList.add('hidden')));
  </script>
</body>
</html>
