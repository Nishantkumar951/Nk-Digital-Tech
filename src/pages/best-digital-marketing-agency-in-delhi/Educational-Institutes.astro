          <Fragment set:html={whySubtitleHtml} />
        </p>
        <p class="text-slate-700 font-semibold text-xs sm:text-sm">
          Compare our growth engine against typical directory packages and generic agencies:
        </p>
      </div>

      <!-- Desktop Comparison Matrix -->
      <div class="hidden md:block overflow-hidden rounded-2xl border border-slate-200 shadow-lg">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-900 text-white">
              <th class="py-5 px-6 text-xs font-bold uppercase tracking-widest text-slate-300 w-1/4">
                Evaluation Criteria
              </th>
              <th class="py-5 px-6 text-xs font-bold uppercase tracking-widest text-rose-300 w-[37.5%] border-l border-slate-800">
                Directory Portals / Generic Agency
              </th>
              <th class="py-5 px-6 text-xs font-bold uppercase tracking-widest text-brand-300 w-[37.5%] border-l border-slate-800 bg-slate-950">
                NK Digital Tech Education Growth
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-sm">
            {comparison.map((row, idx) => (
              <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/80'}>
                <td class="py-5 px-6 font-display font-bold text-slate-900">
                  {row.metric}
                </td>
                <td class="py-5 px-6 text-slate-600 border-l border-slate-200">
                  <div class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-rose-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    <span class="text-justify">{row.typical}</span>
                  </div>
                </td>
                <td class="py-5 px-6 text-slate-900 font-medium border-l border-slate-200 bg-sky-50/40">
                  <div class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-emerald-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-justify">{row.nk}</span>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile Comparison Cards -->
      <div class="md:hidden space-y-3.5">
