  <section id="contact" class="relative surface-dark py-12 pb-24 sm:py-16 lg:py-20 px-4 sm:px-6 overflow-hidden">
    <div class="absolute inset-0 grid-pattern-dark pointer-events-none"></div>
    <div class="relative z-10 max-w-5xl mx-auto">
      <div class="rounded-2xl sm:rounded-3xl bg-gradient-to-r from-brand-600 via-brand-700 to-accent-700 p-6 sm:p-10 md:p-12 text-center text-white shadow-2xl border border-white/15 relative overflow-hidden">
        <div class="relative z-10 max-w-2xl mx-auto">
          <h2 class="font-display font-black text-[1.45rem] sm:text-3xl md:text-4xl text-white tracking-tight leading-snug mb-3 sm:mb-4">
            Ready to Scale Your D2C Brand's Organic Revenue in Lucknow?
          </h2>

          <p class="text-sky-50 text-[13px] sm:text-sm md:text-base leading-relaxed mb-6 sm:mb-8">
            Partner with NK Digital Tech to capture profitable consumer transactions, dominate Google Shopping carousels, and lead AI recommendations across Lucknow.
          </p>

          <a
            href="/contact-us/"
            class="inline-flex w-full sm:w-auto min-h-[48px] items-center justify-center gap-2 sm:gap-3 px-5 sm:px-8 py-3.5 sm:py-4 rounded-xl bg-white text-slate-950 hover:bg-sky-50 no-underline hover:no-underline font-display font-bold text-sm sm:text-base shadow-xl transition-all duration-300 active:scale-95 text-center leading-snug"
          >
            <span>Claim Your Free E-Commerce SEO Audit</span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-brand-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
