<Layout>

  <!-- =====================================================================
       SECTION 1: HERO (DARK SURFACE WITH MESH GLOW & AI COMMAND PREVIEW)
  ===================================================================== -->
  <section class="relative surface-dark overflow-hidden pt-16 pb-24 lg:pt-24 lg:pb-28 border-b border-slate-800/80">
    <div class="absolute inset-0 grid-pattern-dark pointer-events-none"></div>
    <div class="absolute inset-0 mesh-glow pointer-events-none"></div>
    <div class="absolute -top-36 -left-36 w-96 h-96 bg-brand-500/20 rounded-full blur-[130px] pointer-events-none"></div>
    <div class="absolute top-1/4 -right-36 w-96 h-96 bg-accent-500/20 rounded-full blur-[130px] pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Announcement Pill -->
        <div class="badge-dark mb-7">
          <span class="w-2 h-2 rounded-full bg-brand-400 animate-ping"></span>
          <span>Google AI Overviews &bull; ChatGPT &bull; Gemini &bull; Organic Search</span>
        </div>

        <!-- Primary H1 -->
        <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white leading-[1.08] mb-7 text-glow">
          Best Digital Marketing <br class="hidden sm:inline" />
          <span class="gradient-text-light">Company in Delhi NCR</span>
        </h1>

        <!-- Hero Subheadline -->
        <p class="text-base sm:text-lg md:text-xl text-slate-300 leading-relaxed mb-10 max-w-3xl mx-auto font-normal">
          We help ambitious enterprises in Delhi, Noida, Gurgaon and Lucknow build organic search supremacy and AI search visibility, positioning your brand across Google, Google AI Overviews, ChatGPT, Gemini and every platform where your buyers evaluate decisions today.
        </p>

        <!-- Primary & Secondary CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
          <a href="#contact" class="btn-primary text-base px-9 py-4 w-full sm:w-auto">
            <span>Book a Strategic Consultation</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/>
            </svg>
          </a>
          <a href="#services" class="btn-secondary-dark text-base px-8 py-4 w-full sm:w-auto">
            <span>Explore Our 6 Core Disciplines</span>
          </a>
        </div>

        <!-- Trust Verification Strip -->
        <div class="pt-8 border-t border-slate-800/80">
          <p class="text-[11px] uppercase tracking-widest text-slate-400 font-semibold mb-4">
            Verified Omnichannel Search Capabilities
          </p>
          <div class="flex flex-wrap items-center justify-center gap-2.5">
            {trustStrip.map((item) => (
              <span class="px-3.5 py-1.5 rounded-lg bg-slate-900/90 border border-slate-800 text-xs text-slate-300 font-medium">
                {item}
              </span>
            ))}
          </div>
        </div>
