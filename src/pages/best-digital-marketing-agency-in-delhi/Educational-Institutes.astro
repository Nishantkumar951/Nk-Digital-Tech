    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto mb-8 sm:mb-16 text-left sm:text-center">
        <div class="badge-light mb-3">Education Segments We Serve</div>
        <h2 class="font-display font-extrabold text-[clamp(1.34rem,5.3vw,1.75rem)] sm:text-3xl lg:text-4xl text-slate-900 tracking-tight leading-[1.22] sm:leading-tight mb-3 sm:mb-4 break-words">
          Custom Digital Marketing Strategies for Six Delhi Education Verticals
        </h2>
        <p class="text-slate-600 text-[13.5px] sm:text-base leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
          Whether you operate multi branch competitive coaching academies, CBSE schools or private universities, we build search and AI authority aligned to your enrollment cycle.
        </p>
      </div>

      <!-- 3 Columns x 2 Rows Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-7">
        {sectorSegments.map((ind) => (
          <div class={`elevated-card rounded-2xl p-4 sm:p-7 border-t-4 ${ind.accentBorder} flex flex-col justify-between sm:hover:-translate-y-1 min-w-0`}>
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 mb-4 sm:mb-5">
                <div class={`w-10 h-10 sm:w-11 sm:h-11 rounded-xl border flex items-center justify-center flex-shrink-0 ${ind.iconBg}`}>
                  <Fragment set:html={ind.icon} />
                </div>
                <span class="text-[11px] font-semibold text-slate-600 bg-slate-100 px-2.5 py-1 rounded-md">
                  {ind.sector}
                </span>
              </div>

              <h3 class="font-display font-bold text-[17px] sm:text-xl text-slate-900 mb-3 sm:mb-4 leading-snug">
                {ind.title}
              </h3>

              <div class="mb-4 sm:mb-5">
                <p class="text-[11px] font-bold uppercase tracking-wider text-brand-600 mb-1.5">
                  Digital Growth Strategy
                </p>
                <p class="text-slate-600 text-[13px] sm:text-sm leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
                  {ind.focus}
                </p>
              </div>
            </div>

            <div class="rounded-xl bg-emerald-50/70 border border-emerald-200/80 p-3.5 sm:p-4">
              <p class="text-[11px] font-bold uppercase tracking-wider text-emerald-700 mb-1">
                Commercial Result
              </p>
              <p class="text-slate-800 text-xs font-medium leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
                {ind.outcome}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 8: HOW WE WORK (CRISP WHITE CONTRAST SECTION - 4 STAGES)
  ===================================================================== -->
  <section class="relative surface-white py-10 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-200 overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto mb-8 sm:mb-16 text-left sm:text-center">
        <div class="badge-light mb-3">Our 4 Stage Execution</div>
        <h2 class="font-display font-extrabold text-[clamp(1.34rem,5.3vw,1.75rem)] sm:text-3xl lg:text-4xl text-slate-900 tracking-tight leading-[1.22] sm:leading-tight mb-3 sm:mb-4 break-words">
          How We Build High Converting Admission Systems in Delhi
        </h2>
        <p class="text-slate-600 text-[13.5px] sm:text-base leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
          Our four stage model clears mobile speed hurdles first, establishes campus Map Pack authority and grows AI search citations ahead of your peak intake windows.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-7">
        {stages.map((st) => (
          <div class="elevated-card rounded-2xl p-4 sm:p-8 relative overflow-hidden group sm:hover:-translate-y-1 min-w-0">
            <div class="flex items-center justify-between gap-4 mb-3.5 sm:mb-5">
              <span class={`inline-flex items-center px-2.5 sm:px-3 py-1 rounded-lg text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r ${st.accent}`}>
                {st.num}
              </span>
              <span class="font-display font-black text-3xl sm:text-4xl text-slate-200 group-hover:text-slate-300 transition-colors">
                {st.step}
              </span>
            </div>
            <h3 class="font-display font-bold text-[17px] sm:text-xl text-slate-900 mb-2.5 sm:mb-3 leading-snug">
              {st.title}
            </h3>
            <p class="text-slate-600 text-[13px] sm:text-sm leading-relaxed text-left sm:text-justify sm:hyphens-auto sm:[text-align-last:left]">
              {st.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 9: CONCLUSION / PARTNER SECTION (DARK INDIGO + GROWTH IMAGE)
  ===================================================================== -->
  <section class="relative surface-indigo py-10 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-800/80 overflow-hidden">
    <div class="absolute inset-0 grid-pattern-dark pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-7 sm:gap-10 lg:gap-12 items-center">
        <!-- Left 7 Columns: Conclusion Paragraphs -->
        <div class="lg:col-span-7 min-w-0">
          <div class="badge-dark mb-3.5 sm:mb-4">Long Term Admission Growth</div>
          <h2 class="font-display font-extrabold text-[clamp(1.34rem,5.3vw,1.75rem)] sm:text-3xl lg:text-4xl text-white tracking-tight leading-[1.22] sm:leading-tight mb-4 sm:mb-6 break-words">
