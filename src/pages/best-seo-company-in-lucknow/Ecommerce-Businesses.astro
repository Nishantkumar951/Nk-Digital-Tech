            <div class="rounded-xl bg-emerald-50/70 border border-emerald-200/80 p-3.5 sm:p-4">
              <p class="text-[11px] font-bold uppercase tracking-wider text-emerald-700 mb-1">
                Commercial Result
              </p>
              <p class="text-slate-800 text-xs font-medium leading-relaxed text-justify hyphens-auto [text-align-last:left]">
                {ind.outcome}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SECTION 8: HOW WE WORK (CRISP WHITE CONTRAST SECTION - 4 STAGES)
  ===================================================================== -->
  <section class="relative surface-white py-12 sm:py-20 lg:py-24 px-4 sm:px-6 border-b border-slate-200">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto mb-9 sm:mb-16 text-left sm:text-center">
